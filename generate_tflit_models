# FIX 8: LOAD EWS SCALER
# ============================================================
# The scaler MUST be loaded and applied to all calibration EWS
# features. Otherwise the INT8 quantizer computes activation
# ranges from an unnormalised distribution, which collapses
# accuracy (CWRU 99% -> ~40% has been observed).

SCALER_PATH = "/kaggle/input/datasets/pleiades74/ews-scaler-seed256-full/ews_scaler.pkl"
if not os.path.exists(SCALER_PATH):
    SCALER_PATH = "ews_scaler.pkl"

print(f"\n📦 Loading EWS scaler: {SCALER_PATH}")
if not os.path.exists(SCALER_PATH):
    raise FileNotFoundError(
        f"Scaler file not found: {SCALER_PATH}\n"
        f"Upload ews_scaler.pkl next to this script, or fix the path."
    )

scaler = joblib.load(SCALER_PATH)
print(f"   ✅ Scaler loaded")
print(f"      mean shape  = {scaler.mean_.shape}")
print(f"      scale shape = {scaler.scale_.shape}")
print(f"      mean[:3]    = {scaler.mean_[:3]}")
print(f"      scale[:3]   = {scaler.scale_[:3]}")


def _scale_ews(ews_raw: np.ndarray) -> np.ndarray:
    """
    Apply the training StandardScaler to a raw (11,) EWS vector.
    Returns a (11,) float32 vector ready to feed the model.
    """
    ews_raw = np.asarray(ews_raw, dtype=np.float32).reshape(1, 11)
    scaled = scaler.transform(ews_raw).astype(np.float32).reshape(11)
    return scaled


# ============================================================
# EWS FEATURES
# ============================================================

def compute_ews_features(signal: np.ndarray) -> np.ndarray:
    """
    Compute the 11 EWS features.
    IDENTICAL to main.py FeatureExtractor.ews_features,
    including scipy's bias-corrected skewness and kurtosis.
    """
    signal = np.asarray(signal, dtype=np.float32).reshape(-1)
    if len(signal) == 0:
        return np.zeros(11, dtype=np.float32)

    eps = 1e-10
    rms = np.sqrt(np.mean(signal ** 2) + eps)
    peak = np.max(np.abs(signal))
    crest = peak / (rms + eps)
    std_val = np.std(signal)

    if np.std(signal) < eps:
        skew_val, kurt_val = 0.0, -3.0
    else:
        skew_val = skew(signal, bias=False, nan_policy='omit')
        kurt_val = kurtosis(signal, fisher=True, bias=False, nan_policy='omit')

    peak_to_peak = np.ptp(signal)
    mean_abs = np.mean(np.abs(signal)) + eps
    shape_factor = rms / mean_abs
    impulse_factor = peak / mean_abs
    mean_sqrt_abs = np.mean(np.sqrt(np.abs(signal))) + eps
    clearance_factor = peak / (mean_sqrt_abs ** 2 + eps)

    if len(signal) > 2:
        autocorr = np.sum(signal[:-1] * signal[1:]) / (np.sum(signal ** 2) + eps)
    else:
        autocorr = 0.0

    return np.array([rms, peak, crest, std_val, skew_val, kurt_val,
                     peak_to_peak, shape_factor, impulse_factor,
                     clearance_factor, autocorr], dtype=np.float32)


