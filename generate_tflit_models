# ============================================================
# VERIFY PREDICTIONS AGAINST KERAS
# ============================================================

def _find_input_index(input_details, target_shape):
    for d in input_details:
        if list(d['shape']) == target_shape:
            return d['index']
    return None


def _find_output_index(output_details, target_shape):
    for d in output_details:
        if list(d['shape']) == target_shape:
            return d['index']
    return None


def verify_tflite_against_keras(keras_model, tflite_path, samples, n_check=10):
    """
    Compare TFLite predictions to Keras on real calibration samples.
    Both TFLite and Keras see the same scaled EWS inputs.
    """
    interp = tf.lite.Interpreter(model_path=tflite_path)
    interp.allocate_tensors()
    input_details = interp.get_input_details()
    output_details = interp.get_output_details()

    vib_idx = _find_input_index(input_details, [1, 1024, 4])
    ews_idx = _find_input_index(input_details, [1, 11])
    cwru_idx = _find_output_index(output_details, [1, 4])
    pader_idx = _find_output_index(output_details, [1, 3])
    rul_idx = _find_output_index(output_details, [1, 1])

    max_cwru_diff = 0.0
    max_pader_diff = 0.0
    max_rul_diff = 0.0

    n_check = min(n_check, len(samples))
    for i in range(n_check):
        vib, ews = samples[i]

        keras_pred = keras_model([vib, ews], training=False)
        k_cwru = keras_pred['cwru_class'].numpy()[0]
        k_pader = keras_pred['paderborn_class'].numpy()[0]
        k_rul = keras_pred['pronostia_rul'].numpy()[0]

        interp.set_tensor(vib_idx, vib)
        interp.set_tensor(ews_idx, ews)
        interp.invoke()

        if cwru_idx is not None:
            t_cwru = interp.get_tensor(cwru_idx)[0]
            max_cwru_diff = max(max_cwru_diff, float(np.max(np.abs(k_cwru - t_cwru))))
        if pader_idx is not None:
            t_pader = interp.get_tensor(pader_idx)[0]
            max_pader_diff = max(max_pader_diff, float(np.max(np.abs(k_pader - t_pader))))
        if rul_idx is not None:
            t_rul = interp.get_tensor(rul_idx)[0]
            max_rul_diff = max(max_rul_diff, float(np.max(np.abs(k_rul - t_rul))))

    return {
        'cwru_max_abs_diff': max_cwru_diff,
        'paderborn_max_abs_diff': max_pader_diff,
        'rul_max_abs_diff': max_rul_diff,
    }


print("\n" + "="*60)
print("VERIFYING TFLITE PREDICTIONS AGAINST KERAS")
print("="*60)

verification = {}
for name, path in [
    ('FP32', 'tflite_models/model_fp32.tflite'),
    ('FP16', 'tflite_models/model_fp16.tflite'),
    ('INT8', 'tflite_models/model_int8.tflite'),
]:
    if not os.path.exists(path):
        print(f"❌ {name}: file not found, skipping verification")
        continue
    try:
        diffs = verify_tflite_against_keras(model, path, _cal_samples, n_check=10)
        verification[name] = diffs
        print(f"\n{name}:")
        print(f"  CWRU      max |Δ| = {diffs['cwru_max_abs_diff']:.6e}")
        print(f"  Paderborn max |Δ| = {diffs['paderborn_max_abs_diff']:.6e}")
        print(f"  RUL       max |Δ| = {diffs['rul_max_abs_diff']:.6e}")

        if diffs['cwru_max_abs_diff'] > 0.05 or diffs['paderborn_max_abs_diff'] > 0.05:
            print(f"  ⚠️ WARNING: classification deviation > 0.05 — quantization is aggressive")
        elif diffs['cwru_max_abs_diff'] > 0.01 or diffs['paderborn_max_abs_diff'] > 0.01:
            print(f"  ℹ️ Moderate deviation (0.01–0.05) — acceptable for most use cases")
        else:
            print(f"  ✅ Deviation < 0.01 — quantization is safe")
    except Exception as e:
        print(f"❌ {name}: verification failed — {e}")
        verification[name] = {'error': str(e)}


