# ============================================================
# CALIBRATION SAMPLE LOADERS
# EWS is now SCALED via _scale_ews before being stored
# ============================================================

def _load_cwru_samples():
    samples = []
    all_files = sorted(glob.glob(os.path.join(CWRU_DIR, "*.csv")))
    if not all_files:
        print(f"   ⚠️ No CWRU files at {CWRU_DIR}")
        return samples
    rng.shuffle(all_files)
    files = all_files[:20]
    for f in files:
        try:
            df = pd.read_csv(f)
            cols = df.columns.tolist()
            de = next((c for c in cols if 'DE' in c.upper()), None)
            fe = next((c for c in cols if 'FE' in c.upper()), None)
            ba = next((c for c in cols if 'BA' in c.upper()), None)
            if not (de and fe):
                continue
            de_arr = pd.to_numeric(df[de], errors='coerce').dropna().values.astype(np.float32)
            fe_arr = pd.to_numeric(df[fe], errors='coerce').dropna().values.astype(np.float32)
            ba_arr = pd.to_numeric(df[ba], errors='coerce').dropna().values.astype(np.float32) \
                     if ba else np.zeros_like(de_arr)
            n = min(len(de_arr), len(fe_arr), len(ba_arr))
            if n < WINDOW:
                continue
            raw = np.stack([de_arr[:n], fe_arr[:n], ba_arr[:n]], axis=1)
            padded = np.zeros((n, 4), dtype=np.float32)
            padded[:, :3] = raw
            for start in range(0, n - WINDOW + 1, WINDOW * 4):
                win = padded[start:start + WINDOW]
                # CWRU: EWS uses ALL channels (matches training)
                ch_feats = [compute_ews_features(win[:, c]) for c in range(3)]
                ews_raw = np.mean(ch_feats, axis=0)
                ews = _scale_ews(ews_raw)                       # ← FIX 8
                samples.append((win[None, ...].astype(np.float32),
                                ews[None, ...].astype(np.float32)))
                if len(samples) >= N_PER_DATASET:
                    return samples
        except Exception:
            continue
    return samples


def _load_paderborn_samples():
    samples = []
    all_files = sorted(glob.glob(os.path.join(PADERBORN_DIR, "**", "*.mat"),
                                  recursive=True))
    if not all_files:
        print(f"   ⚠️ No Paderborn files at {PADERBORN_DIR}")
        return samples
    rng.shuffle(all_files)
    files = all_files[:20]
    for f in files:
        try:
            mat = sio.loadmat(f)
            key = next((k for k in mat.keys() if k.startswith('N') and not k.startswith('__')), None)
            if key is None:
                continue
            ds = mat[key]
            if ds.shape == (1, 1):
                ds = ds[0, 0]
            if not hasattr(ds, 'dtype') or 'Y' not in ds.dtype.names:
                continue
            Y = ds['Y']
            vib, c1, c2, temp = None, None, None, None
            for i in range(Y.shape[1] if Y.ndim == 2 else Y.size):
                item = Y[0, i] if Y.ndim == 2 else Y[i]
                if not hasattr(item, 'dtype') or not item.dtype.names:
                    continue
                name = None
                if 'Name' in item.dtype.names:
                    try:
                        rn = item['Name']
                        while isinstance(rn, np.ndarray) and rn.size == 1:
                            rn = rn.item()
                        name = str(rn).strip()
                    except Exception:
                        name = None
                if 'Data' not in item.dtype.names or name is None:
                    continue
                arr = np.asarray(item['Data'], dtype=np.float32).reshape(-1)
                if name == 'vibration_1': vib = arr
                elif name == 'phase_current_1': c1 = arr
                elif name == 'phase_current_2': c2 = arr
                elif name == 'temp_2_bearing_module': temp = arr
            if vib is None or len(vib) < WINDOW:
                continue
            n = len(vib)
            if c1 is None or len(c1) != n: c1 = np.zeros(n, dtype=np.float32)
            if c2 is None or len(c2) != n: c2 = np.zeros(n, dtype=np.float32)
            if temp is None or len(temp) != n: temp = np.zeros(n, dtype=np.float32)
            stacked = np.stack([vib, c1, c2, temp], axis=1)
            for start in range(0, n - WINDOW + 1, WINDOW * 4):
                win = stacked[start:start + WINDOW]
                # Paderborn: EWS uses VIBRATION ONLY (matches training)
                ews_raw = compute_ews_features(win[:, 0])
                ews = _scale_ews(ews_raw)                       # ← FIX 8
                samples.append((win[None, ...].astype(np.float32),
                                ews[None, ...].astype(np.float32)))
                if len(samples) >= N_PER_DATASET:
                    return samples
        except Exception:
            continue
    return samples


def _load_pronostia_samples():
    samples = []
    all_files = sorted(glob.glob(os.path.join(PRONOSTIA_DIR, "**", "acc_*.csv"),
                                  recursive=True))
    if not all_files:
        print(f"   ⚠️ No Pronostia files at {PRONOSTIA_DIR}")
        return samples
    rng.shuffle(all_files)
    files = all_files[:20]
    for f in files:
        try:
            with open(f, 'r') as fh:
                first = fh.readline()
            sep = ';' if ';' in first else ','
            df = pd.read_csv(f, header=None, delimiter=sep)
            arr = df.values.astype(np.float32)
            if arr.shape[1] >= 6:
                h, v = arr[:, 4], arr[:, 5]
            elif arr.shape[1] >= 2:
                h, v = arr[:, 0], arr[:, 1]
            else:
                continue
            n = min(len(h), len(v))
            if n < WINDOW:
                continue
            stacked = np.stack([h[:n], v[:n]], axis=1)
            padded = np.zeros((n, 4), dtype=np.float32)
            padded[:, :2] = stacked
            for start in range(0, n - WINDOW + 1, WINDOW * 4):
                win = padded[start:start + WINDOW]
                # Pronostia: EWS uses ALL 2 channels (matches training)
                ch_feats = [compute_ews_features(win[:, c]) for c in range(2)]
                ews_raw = np.mean(ch_feats, axis=0)
                ews = _scale_ews(ews_raw)                       # ← FIX 8
                samples.append((win[None, ...].astype(np.float32),
                                ews[None, ...].astype(np.float32)))
                if len(samples) >= N_PER_DATASET:
                    return samples
        except Exception:
            continue
    return samples


