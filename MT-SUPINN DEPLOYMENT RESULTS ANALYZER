def load_cwru_predictions(file_path):
    """Load CWRU predictions."""
    data = []
    num_classes = 4
    
    with open(file_path, 'r') as f:
        lines = f.readlines()
    
    if not lines:
        return pd.DataFrame()
    
    has_header = any(k in lines[0].lower() for k in ['file', 'start', 'class', 'confidence', 'probabilities', 'time'])
    start_idx = 1 if has_header else 0
    
    for line in lines[start_idx:]:
        line = line.strip()
        if not line:
            continue
        
        try:
            parts = list(csv.reader([line], delimiter=',', quotechar='"'))[0]
        except:
            parts = line.split(',')
        
        if len(parts) < 6:
            continue
        
        filename = parts[0].strip()
        
        try:
            window_start = int(float(parts[1].strip()))
        except ValueError:
            window_start = 0
        
        try:
            predicted_class = int(float(parts[2].strip()))
        except ValueError:
            predicted_class = -1
        
        try:
            confidence = float(parts[3].strip())
        except ValueError:
            confidence = 0.5
        
        probs = parse_probabilities(parts[4])
        
        while len(probs) < num_classes:
            probs.append(0.0)
        probs = probs[:num_classes]
        
        try:
            inference_time = float(parts[5].strip())
        except ValueError:
            inference_time = 0.0
        
        if predicted_class < 0 or predicted_class >= len(probs):
            prob_sum = sum(probs)
            if prob_sum > 0:
                predicted_class = int(np.argmax(probs))
                confidence = float(probs[predicted_class])
            else:
                predicted_class = 0
                confidence = 0.0
        
        data.append({
            'filename': filename,
            'window_start': window_start,
            'predicted_class': predicted_class,
            'confidence': min(max(confidence, 0.0), 1.0),
            'inference_time_ms': inference_time,
            'probabilities': probs,
            **{f'prob_{i}': probs[i] if i < len(probs) else 0.0 for i in range(num_classes)}
        })
    
    df = pd.DataFrame(data)
    print(f"   Parsed {len(df)} rows from CWRU log")
    return df

