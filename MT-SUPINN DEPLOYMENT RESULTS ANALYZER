def plot_pronostia_accuracy(df_merged, output_dir='.'):
    """Plot Pronostia predictions vs ground truth."""
    if df_merged is None or len(df_merged) == 0:
        return
    
    fig, axes = plt.subplots(1, 2, figsize=(12, 5))
    
    # Scatter plot
    ax1 = axes[0]
    ax1.scatter(df_merged['rul_true'], df_merged['rul_pred'], alpha=0.5, s=5, c='steelblue')
    ax1.plot([0, 1], [0, 1], 'r--', linewidth=2, label='Ideal')
    ax1.set_xlabel('True RUL')
    ax1.set_ylabel('Predicted RUL')
    ax1.set_title('Pronostia: Predictions vs Ground Truth')
    ax1.legend()
    ax1.grid(True, alpha=0.3)
    
    # Error histogram
    ax2 = axes[1]
    errors = df_merged['rul_true'] - df_merged['rul_pred']
    ax2.hist(errors, bins=50, color='steelblue', edgecolor='black', alpha=0.7)
    ax2.axvline(x=0, color='red', linestyle='--', linewidth=2)
    ax2.set_xlabel('Prediction Error (True - Predicted)')
    ax2.set_ylabel('Frequency')
    ax2.set_title('Pronostia: Error Distribution')
    ax2.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.savefig(os.path.join(output_dir, 'PRONOSTIA_ACCURACY.pdf'), dpi=300)
    plt.close()
    print(f"✅ Saved: PRONOSTIA_ACCURACY.pdf")
