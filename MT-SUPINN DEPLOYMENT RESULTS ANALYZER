def analyze_predictions(df, class_mapping, ground_truth_parser, dataset_name=""):
    """
    Complete analysis with window-level and file-level metrics.
    """
    results = {}
    
    if len(df) == 0:
        print(f"⚠️ No data to analyze for {dataset_name}")
        return results
    
    # Add ground truth
    df['true_class_name'], df['true_class_idx'] = zip(*df['filename'].apply(ground_truth_parser))
    
    df_original_len = len(df)
    df = df[df['true_class_idx'] >= 0].copy()
    if len(df) == 0:
        print(f"⚠️ No valid ground truth found for {dataset_name}")
        return results
    
    print(f"   Ground truth assigned to {len(df)} rows ({df_original_len - len(df)} skipped)")
    
    # Window-level metrics
    df['window_correct'] = df['true_class_idx'] == df['predicted_class']
    window_accuracy = df['window_correct'].mean()
    total_windows = len(df)
    correct_windows = df['window_correct'].sum()
    
    # File-level metrics (majority voting)
    file_results = []
    for filename, group in df.groupby('filename'):
        true_class_idx = group['true_class_idx'].iloc[0]
        true_class_name = group['true_class_name'].iloc[0]
        
        pred_classes = group['predicted_class'].tolist()
        majority_class = Counter(pred_classes).most_common(1)[0][0]
        
        mean_confidence = group['confidence'].mean()
        window_acc = group['window_correct'].mean()
        
        # Count votes per class
        vote_counts = Counter(pred_classes)
        majority_votes = vote_counts[majority_class]
        total_votes = len(pred_classes)
        
        file_results.append({
            'filename': filename,
            'true_class_idx': true_class_idx,
            'true_class_name': true_class_name,
            'predicted_class': majority_class,
            'is_correct': true_class_idx == majority_class,
            'window_accuracy': window_acc,
            'mean_confidence': mean_confidence,
            'num_windows': total_votes,
            'correct_windows': group['window_correct'].sum(),
            'majority_votes': majority_votes,
            'majority_percent': majority_votes / total_votes * 100
        })
    
    file_df = pd.DataFrame(file_results)
    file_accuracy = file_df['is_correct'].mean()
    
    results['window_level'] = {
        'total_windows': total_windows,
        'correct_windows': correct_windows,
        'accuracy': window_accuracy,
        'accuracy_percent': window_accuracy * 100
    }
    
    results['file_level'] = {
        'total_files': len(file_df),
        'correct_files': file_df['is_correct'].sum(),
        'accuracy': file_accuracy,
        'accuracy_percent': file_accuracy * 100
    }
    
    # Per-class metrics (file-level)
    per_class = []
    for class_idx, class_name in class_mapping.items():
        class_df = file_df[file_df['true_class_idx'] == class_idx]
        if len(class_df) > 0:
            class_correct = class_df['is_correct'].sum()
            class_total = len(class_df)
            per_class.append({
                'class_idx': class_idx,
                'class_name': class_name,
                'total_files': class_total,
                'correct_files': class_correct,
                'accuracy': class_correct / class_total if class_total > 0 else 0,
                'accuracy_percent': (class_correct / class_total * 100) if class_total > 0 else 0
            })
    
    results['per_class'] = pd.DataFrame(per_class) if per_class else pd.DataFrame()
    
    # Confusion Matrix (file-level)
    classes = list(class_mapping.keys())
    cm = np.zeros((len(classes), len(classes)), dtype=int)
    for i, true_idx in enumerate(classes):
        for j, pred_idx in enumerate(classes):
            cm[i, j] = len(file_df[(file_df['true_class_idx'] == true_idx) & 
                                   (file_df['predicted_class'] == pred_idx)])
    results['confusion_matrix'] = cm
    results['confusion_matrix_df'] = pd.DataFrame(
        cm,
        index=[class_mapping[c] for c in classes],
        columns=[class_mapping[c] for c in classes]
    )
    
    # Confidence analysis
    results['confidence_stats'] = {
        'mean': df['confidence'].mean(),
        'std': df['confidence'].std(),
        'min': df['confidence'].min(),
        'max': df['confidence'].max(),
        'median': df['confidence'].median()
    }
    
    correct_conf = df[df['window_correct']]['confidence'].mean() if df[df['window_correct']].shape[0] > 0 else 0
    incorrect_conf = df[~df['window_correct']]['confidence'].mean() if df[~df['window_correct']].shape[0] > 0 else 0
    
    results['confidence_by_correct'] = {
        'correct_mean': correct_conf,
        'incorrect_mean': incorrect_conf
    }
    
    # Latency statistics
    results['latency_stats'] = {
        'mean_ms': df['inference_time_ms'].mean(),
        'std_ms': df['inference_time_ms'].std(),
        'min_ms': df['inference_time_ms'].min(),
        'max_ms': df['inference_time_ms'].max(),
        'median_ms': df['inference_time_ms'].median(),
        'p95_ms': df['inference_time_ms'].quantile(0.95),
        'p99_ms': df['inference_time_ms'].quantile(0.99)
    }
    
    # Class distribution
    results['true_distribution'] = file_df['true_class_name'].value_counts().to_dict()
    results['predicted_distribution'] = file_df['predicted_class'].map(
        lambda x: class_mapping.get(x, 'Unknown')).value_counts().to_dict()
    
    results['df'] = df
    results['file_df'] = file_df
    
    return results

