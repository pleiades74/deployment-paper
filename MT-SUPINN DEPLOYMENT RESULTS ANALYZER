    if 'confusion_matrix_df' in results and len(results['confusion_matrix_df']) > 0:
        results['confusion_matrix_df'].to_csv(
            os.path.join(output_dir, f'{dataset_name}_CONFUSION_MATRIX.csv')
        )
        print(f"✅ Saved: {dataset_name}_CONFUSION_MATRIX.csv")
    
    if 'file_df' in results and len(results['file_df']) > 0:
        results['file_df'].to_csv(
            os.path.join(output_dir, f'{dataset_name}_FILE_RESULTS.csv'), index=False
        )
        print(f"✅ Saved: {dataset_name}_FILE_RESULTS.csv")
    
    if 'latency_stats' in results:
        pd.DataFrame([results['latency_stats']]).to_csv(
            os.path.join(output_dir, f'{dataset_name}_LATENCY.csv'), index=False
        )
