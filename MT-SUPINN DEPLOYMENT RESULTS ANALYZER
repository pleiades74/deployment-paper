    results['rul_max'] = df['rul'].max()
    results['rul_median'] = df['rul'].median()
    
    results['latency_mean'] = df['inference_time_ms'].mean()
    results['latency_std'] = df['inference_time_ms'].std()
    results['latency_min'] = df['inference_time_ms'].min()
    results['latency_max'] = df['inference_time_ms'].max()
    results['latency_p95'] = df['inference_time_ms'].quantile(0.95)
    results['latency_p99'] = df['inference_time_ms'].quantile(0.99)
    
    results['rul_healthy'] = (df['rul'] >= 0.8).sum()
    results['rul_warning'] = ((df['rul'] >= 0.5) & (df['rul'] < 0.8)).sum()
    results['rul_critical'] = ((df['rul'] >= 0.2) & (df['rul'] < 0.5)).sum()
    results['rul_failing'] = (df['rul'] < 0.2).sum()
    
    return results

