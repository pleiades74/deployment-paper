def parse_probabilities(prob_str):
    """
    Parse probability arrays from CSV.
    Handles: [0.0037, 0.0001, 0.9961] or [0.0037 0.0001 0.9961]
    """
    if not prob_str or prob_str == '[]':
        return []
    
    prob_str = prob_str.strip()
    prob_str = prob_str.strip('[]')
    
    # Split by comma or space
    if ',' in prob_str:
        parts = [p.strip() for p in prob_str.split(',') if p.strip()]
    else:
        parts = [p.strip() for p in prob_str.split() if p.strip()]
    
    result = []
    for p in parts:
        try:
            result.append(float(p))
        except ValueError:
            continue
    
    return result

