def extract_bearing_code(filename):
    """
    Extract bearing code from Paderborn filename.
    
    Examples:
    N09_M07_F10_KA01_1.mat → KA01
    N15_M01_F10_KA01_10.mat → KA01
    N09_M07_F10_KA01_R_1.mat → KA01_R
    """
    name = filename.replace('.mat', '').replace('.csv', '')
    
    patterns = [
        r'(K[A-Z]\d{2}(?:_R)?)',  # KA01, KI04, KA01_R
        r'(K\d{3})',               # K001, K002
        r'(KB\d{2})'               # KB23, KB24
    ]
    
    for pattern in patterns:
        match = re.search(pattern, name, re.IGNORECASE)
        if match:
            return match.group(1).upper()
    
    # Fallback: find any K pattern
    match = re.search(r'(K[A-Z]?\d{2,3})', name, re.IGNORECASE)
    if match:
        return match.group(1).upper()
    
    return None

def parse_paderborn_ground_truth(filename):
    """
    Get ground truth class for Paderborn filename using bearing code mapping.
    """
    bearing_code = extract_bearing_code(filename)
    
    if bearing_code is None:
        return 'Unknown', -1
    
    # Check if we have a direct mapping
    if bearing_code in PADERBORN_BEARING_MAP:
        return PADERBORN_BEARING_MAP[bearing_code]
    
    # If not found, infer from code
    if bearing_code.startswith('K0') or bearing_code.startswith('K00'):
        return 'Normal', 0
    elif bearing_code.startswith('KA') or bearing_code.startswith('KB') or bearing_code.startswith('KC'):
        return 'OuterRace', 2
    elif bearing_code.startswith('KI'):
        return 'InnerRace', 1
    
    print(f"⚠️ Unknown bearing code: {bearing_code} from file: {filename}")
    return 'Unknown', -1

