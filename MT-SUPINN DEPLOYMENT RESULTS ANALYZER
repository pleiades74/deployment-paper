def save_results(results, dataset_name, output_dir='.'):
    """Save all results to CSV."""
    os.makedirs(output_dir, exist_ok=True)
    
    summary_data = {}
    if 'window_level' in results:
        summary_data.update({f'window_{k}': v for k, v in results['window_level'].items()})
