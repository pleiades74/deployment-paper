def analyze_pronostia_with_ground_truth(predictions_file, ground_truth_file):
    """
    Merge Pronostia deployment predictions with ground truth.

    The deploy script and ground-truth script slice windows the same way
    within each file, so we align by (bearing, file) + rank within file.
    The window_start value differs because the deploy script uses a
    global bearing-level counter while the ground truth resets per file,
    so we ignore it for matching.
    """
    from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score

    df_pred = pd.read_csv(predictions_file)
    df_true = pd.read_csv(ground_truth_file)

    print(f"   Predictions rows:  {len(df_pred)}")
    print(f"   Ground truth rows: {len(df_true)}")
    print(f"   Predictions columns:  {df_pred.columns.tolist()}")
    print(f"   Ground truth columns: {df_true.columns.tolist()}")

    # ---- Validate schema ----
    for col in ('bearing', 'file', 'window_start', 'rul'):
        if col not in df_pred.columns:
            print(f"   ❌ Predictions missing column: {col}")
            return None, None
        if col not in df_true.columns:
            print(f"   ❌ Ground truth missing column: {col}")
            return None, None

    # ---- Sort and rank within each (bearing, file) ----
    df_pred = df_pred.sort_values(['bearing', 'file', 'window_start']).reset_index(drop=True)
    df_true = df_true.sort_values(['bearing', 'file', 'window_start']).reset_index(drop=True)

    df_pred['rank'] = df_pred.groupby(['bearing', 'file']).cumcount()
    df_true['rank'] = df_true.groupby(['bearing', 'file']).cumcount()

    # ---- Merge by (bearing, file, rank) ----
    df_merged = df_pred.merge(
        df_true[['bearing', 'file', 'rank', 'rul']],
        on=['bearing', 'file', 'rank'],
        how='inner',
        suffixes=('_pred', '_true'),
    )

    match_rate = len(df_merged) / max(1, min(len(df_pred), len(df_true)))
    print(f"   Matched rows: {len(df_merged)} (match rate = {match_rate:.2%})")

    if len(df_merged) == 0:
        return None, None

    # ---- Per-bearing breakdown ----
    print("\n   Per-bearing RMSE:")
    for bearing, group in df_merged.groupby('bearing'):
        b_rmse = np.sqrt(mean_squared_error(group['rul_true'], group['rul_pred']))
        print(f"     {bearing}: n={len(group)}, RMSE={b_rmse:.4f}")

    # ---- Overall metrics ----
    y_pred = df_merged['rul_pred'].values
    y_true = df_merged['rul_true'].values

    rmse = np.sqrt(mean_squared_error(y_true, y_pred))
    mae  = mean_absolute_error(y_true, y_pred)
    r2   = r2_score(y_true, y_pred)
    err  = y_true - y_pred

    print(f"\n   ✅ Aligned {len(y_pred)} samples")
    print(f"   RMSE: {rmse:.4f}")
    print(f"   MAE:  {mae:.4f}")
    print(f"   R²:   {r2:.4f}")
    print(f"   Max |error|: {np.max(np.abs(err)):.4f}")
    print(f"   Mean error:  {np.mean(err):+.4f}")
    print(f"   Std error:   {np.std(err):.4f}")

    results = {
        'rmse': rmse, 'mae': mae, 'r2': r2,
        'max_error': float(np.max(np.abs(err))),
        'mean_error': float(np.mean(err)),
        'std_error': float(np.std(err)),
        'n_samples': len(y_pred),
        'match_rate': match_rate,
    }

    df_merged_out = df_merged[['bearing', 'file', 'rank',
                                'rul_pred', 'rul_true']].copy()
    return results, df_merged_out
