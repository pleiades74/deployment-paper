def run_enhanced_training(model, train_gen, val_gen, config, trainer):
    print("\n🚀 Starting enhanced training...")
    print("="*60)
    print(f"Train generator length: {len(train_gen)} batches")
    print(f"Val generator length: {len(val_gen)} batches")
    
    best_loss = float('inf')
    best_epoch = 0
    best_weights = None
    patience_counter = 0
    early_stop_patience = 15
    losses_history = []
    val_losses_history = []
    
    if config.cluster_loss_weight > 0:
        print("🔧 Initializing cluster centers BEFORE training...")
        trainer.initialize_cluster_centers(train_gen, num_clusters=config.n_clusters)

    # =============================================
    # PHYSICS DIAGNOSTIC — fires at epochs 1, 15, 30
    # =============================================
    physics_diag = PhysicsDiagnosticCallback(
        trainer=trainer,
        generator=train_gen,
        epochs_to_check=(1, 15, 30),
        output_path='physics_diagnostic.txt'
    )
    # =============================================
    
    for epoch in range(config.epochs):
        trainer.current_epoch = epoch

        print(f"\n{'='*40}")
        print(f"EPOCH {epoch+1}/{config.epochs} STARTING")
        print(f"{'='*40}")
        
        epoch_losses = []
        epoch_cwru_losses = []
        epoch_paderborn_losses = []
        epoch_rul_losses = []
        epoch_mono_losses = []
        epoch_cluster_losses = []
        epoch_domain_losses = []

        # Training phase
        print(f"Training phase - {len(train_gen)} batches...")
        for batch_idx in range(len(train_gen)):
            try:
                inputs, outputs, extra = train_gen[batch_idx]
                metrics = trainer.train_step(inputs, outputs, extra, is_training=True)                
                epoch_losses.append(metrics['loss'].numpy())
                epoch_cwru_losses.append(metrics['cwru_loss'].numpy())
                epoch_paderborn_losses.append(metrics['paderborn_loss'].numpy())
                epoch_rul_losses.append(metrics['rul_loss'].numpy())
                epoch_mono_losses.append(metrics['mono_loss'].numpy())
                epoch_cluster_losses.append(metrics['cluster_loss'].numpy())
                epoch_domain_losses.append(metrics['domain_loss'].numpy())
            except Exception as e:
                print(f"    ❌ ERROR in batch {batch_idx}: {e}", flush=True)
                raise
        
        print(f"Training complete. Computing averages...", flush=True)
        avg_loss = np.mean(epoch_losses)
        avg_cwru_loss = np.mean(epoch_cwru_losses)
        avg_paderborn_loss = np.mean(epoch_paderborn_losses)
        avg_rul_loss = np.mean(epoch_rul_losses)
        avg_mono_loss = np.mean(epoch_mono_losses)
        avg_cluster_loss = np.mean(epoch_cluster_losses)
        avg_domain_loss = np.mean(epoch_domain_losses) if epoch_domain_losses else 0.0
        losses_history.append(avg_loss)
        
        if epoch == 0 and trainer.cluster_centers is None and config.cluster_loss_weight > 0:
            trainer.initialize_cluster_centers(train_gen, num_clusters=config.n_clusters)
        
        if epoch > 0 and epoch % 15 == 0 and trainer.cluster_centers is not None:
            print(f"  🔄 Re-initializing cluster centers at epoch {epoch+1}...")
            trainer.initialize_cluster_centers(train_gen, num_clusters=config.n_clusters)
        
        # Validation phase
        val_losses = []
        for batch_idx in range(len(val_gen)):
            inputs, outputs, extra = val_gen[batch_idx]
            metrics = trainer.train_step(inputs, outputs, extra, is_training=False)
            val_losses.append(metrics['loss'].numpy())
        avg_val_loss = np.mean(val_losses)
        val_losses_history.append(avg_val_loss)
        
        print(f"\nEpoch {epoch+1}/{config.epochs}")
        print(f"  Train Loss: {avg_loss:.4f} (CWRU: {avg_cwru_loss:.4f}, Paderborn: {avg_paderborn_loss:.4f}, RUL: {avg_rul_loss:.4f})")
        print(f"  Physics: Mono={avg_mono_loss:.4f}, Cluster={avg_cluster_loss:.4f}")
        print(f"  Domain Loss: {avg_domain_loss:.4f}")
        print(f"  Val Loss: {avg_val_loss:.4f}")
        physics_diag.on_epoch_end(epoch, {})
        
        if avg_val_loss < best_loss:
            best_loss = avg_val_loss
            best_epoch = epoch + 1
            best_weights = model.get_weights()
            print(f"  ✓ New best model! (val_loss: {best_loss:.6f})")
            patience_counter = 0
        else:
            patience_counter += 1
        
        if patience_counter >= early_stop_patience and epoch > 30:
            print(f"\n⏹️ Early stopping at epoch {epoch+1}")
            break
    
    # =============================================
    # SAVE THE BEST MODEL AFTER TRAINING COMPLETES
    # =============================================
    if best_weights is not None:
        model.set_weights(best_weights)
        print(f"\n✅ Loaded best model from epoch {best_epoch} (val_loss: {best_loss:.6f})")

        # Skip deployment export during ablation runs (breaks on Lambda-based dummy domain head)
        skip_export = getattr(config, 'skip_deployment_export', False)
        if not skip_export and not getattr(config, 'use_dann', True):
            skip_export = True
            print("  ⏭️ Skipping model export (DANN disabled — Lambda dummy head not TFLite-safe)")

        if not skip_export:
            print("\n💾 Saving model files...")

            # 1. Save weights
            try:
                model.save_weights('mt_supinn_weights.weights.h5')
                print("  ✅ Saved weights: mt_supinn_weights.weights.h5")
            except Exception as e:
                print(f"  ❌ Failed to save weights: {e}")

            # 2. TFLite conversion with SELECT_TF_OPS
            try:
                converter = tf.lite.TFLiteConverter.from_keras_model(model)
                converter.target_spec.supported_ops = [
                    tf.lite.OpsSet.TFLITE_BUILTINS,
                    tf.lite.OpsSet.SELECT_TF_OPS
                ]
                converter._experimental_lower_tensor_list_ops = False
                converter.optimizations = [tf.lite.Optimize.DEFAULT]
                tflite_model = converter.convert()
                with open('mt_supinn_lightweight.tflite', 'wb') as f:
                    f.write(tflite_model)
                print("  ✅ Saved: mt_supinn_lightweight.tflite")
            except Exception as e:
                print(f"  ❌ Failed to save .tflite: {e}")
                # Try alternative without optimization
                try:
                    converter = tf.lite.TFLiteConverter.from_keras_model(model)
                    converter.target_spec.supported_ops = [
                        tf.lite.OpsSet.TFLITE_BUILTINS,
                        tf.lite.OpsSet.SELECT_TF_OPS
                    ]
                    converter._experimental_lower_tensor_list_ops = False
                    converter.optimizations = []
                    tflite_model = converter.convert()
                    with open('mt_supinn_lightweight.tflite', 'wb') as f:
                        f.write(tflite_model)
                    print("  ✅ Saved (alternative): mt_supinn_lightweight.tflite")
                except Exception as e2:
                    print(f"  ❌ Alternative also failed: {e2}")

            # 3. Verify files exist
            print("\n  📁 Files in /kaggle/working:")
            for f in ['mt_supinn_weights.weights.h5', 'mt_supinn_lightweight.tflite', 'ews_scaler.pkl']:
                if os.path.exists(f):
                    size = os.path.getsize(f) / 1024
                    print(f"    ✅ {f}: {size:.2f} KB")
                else:
                    print(f"    ❌ {f} NOT FOUND")

    # =============================================
    # RETURN STATEMENT - OUTSIDE THE IF BLOCK
    # =============================================
    return model, losses_history, val_losses_history, best_epoch, best_loss


