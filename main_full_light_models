def build_strong_baselines(config):
    """
    Build stronger baselines for comparison.
    """
    print("\n" + "="*80)
    print("BUILDING STRONGER BASELINES")
    print("="*80)
    
    baselines = {}
    
    # 1. ResNet-like baseline
    def build_resnet_baseline():
        print("  Building ResNet baseline...")
        input_layer = layers.Input(shape=(config.window_size, 4))
        
        def resnet_block(x, filters, kernel_size=7):
            shortcut = x
            x = layers.Conv1D(filters, kernel_size, padding='same')(x)
            x = layers.BatchNormalization()(x)
            x = layers.Activation('relu')(x)
            x = layers.Conv1D(filters, kernel_size, padding='same')(x)
            x = layers.BatchNormalization()(x)
            if shortcut.shape[-1] != filters:
                shortcut = layers.Conv1D(filters, 1, padding='same')(shortcut)
                shortcut = layers.BatchNormalization()(shortcut)
            x = layers.Add()([x, shortcut])
            x = layers.Activation('relu')(x)
            return x
        
        x = layers.Conv1D(64, 7, padding='same')(input_layer)
        x = layers.BatchNormalization()(x)
        x = layers.Activation('relu')(x)
        x = layers.MaxPooling1D(2)(x)
        
        # 3 ResNet blocks
        for filters in [64, 128, 256]:
            x = resnet_block(x, filters)
            x = layers.MaxPooling1D(2)(x)
        
        x = layers.GlobalAveragePooling1D()(x)
        x = layers.Dense(256, activation='relu')(x)
        x = layers.Dropout(0.5)(x)
        
        cwru_out = layers.Dense(config.cwru_classes, activation='softmax', name='cwru_class')(x)
        paderborn_out = layers.Dense(config.paderborn_classes, activation='softmax', name='paderborn_class')(x)
        pronostia_out = layers.Dense(1, activation='sigmoid', name='pronostia_rul')(x)
        
        return Model(inputs=input_layer, outputs={'cwru_class': cwru_out,
                                                   'paderborn_class': paderborn_out,
                                                   'pronostia_rul': pronostia_out})
    
    # 2. Transformer baseline
    def build_transformer_baseline():
        print("  Building Transformer baseline...")
        input_layer = layers.Input(shape=(config.window_size, 4))
        
        # Positional encoding
        x = layers.Conv1D(64, 1, padding='same')(input_layer)
        
        # Transformer encoder
        for _ in range(3):
            # Multi-head attention
            attn = layers.MultiHeadAttention(num_heads=4, key_dim=32)(x, x)
            attn = layers.Dropout(0.1)(attn)
            x = layers.Add()([x, attn])
            x = layers.LayerNormalization()(x)
            
            # Feed forward
            ff = layers.Dense(128, activation='relu')(x)
            ff = layers.Dense(64)(ff)
            ff = layers.Dropout(0.1)(ff)
            x = layers.Add()([x, ff])
            x = layers.LayerNormalization()(x)
        
        x = layers.GlobalAveragePooling1D()(x)
        x = layers.Dense(128, activation='relu')(x)
        x = layers.Dropout(0.5)(x)
        
        cwru_out = layers.Dense(config.cwru_classes, activation='softmax', name='cwru_class')(x)
        paderborn_out = layers.Dense(config.paderborn_classes, activation='softmax', name='paderborn_class')(x)
        pronostia_out = layers.Dense(1, activation='sigmoid', name='pronostia_rul')(x)
        
        return Model(inputs=input_layer, outputs={'cwru_class': cwru_out,
                                                   'paderborn_class': paderborn_out,
                                                   'pronostia_rul': pronostia_out})
    
    # 3. Multi-task baseline (without physics)
    def build_multi_task_baseline():
        print("  Building Multi-Task baseline...")
        input_layer = layers.Input(shape=(config.window_size, 4))
        
        x = layers.Conv1D(64, 7, padding='same', activation='relu')(input_layer)
        x = layers.MaxPooling1D(2)(x)
        x = layers.Conv1D(128, 5, padding='same', activation='relu')(x)
        x = layers.MaxPooling1D(2)(x)
        x = layers.Conv1D(256, 3, padding='same', activation='relu')(x)
        x = layers.GlobalAveragePooling1D()(x)
        x = layers.Dense(256, activation='relu')(x)
        x = layers.Dropout(0.5)(x)
        
        # Task-specific heads
        cwru_out = layers.Dense(config.cwru_classes, activation='softmax', name='cwru_class')(x)
        paderborn_out = layers.Dense(config.paderborn_classes, activation='softmax', name='paderborn_class')(x)
        pronostia_out = layers.Dense(1, activation='sigmoid', name='pronostia_rul')(x)
        
        return Model(inputs=input_layer, outputs={'cwru_class': cwru_out,
                                                   'paderborn_class': paderborn_out,
                                                   'pronostia_rul': pronostia_out})
    
    # Build all baselines
    baselines['ResNet'] = build_resnet_baseline()
    baselines['Transformer'] = build_transformer_baseline()
    baselines['Multi-Task'] = build_multi_task_baseline()
    
    print(f"  ✅ Built {len(baselines)} strong baselines")
    return baselines

