class PhysicsLosses:
    def __init__(self, config):
        self.config = config
    @tf.function 
    def monotonicity_loss(self, damage, cycles):
        if tf.size(damage) < 2:
            return tf.constant(0.0)
        damage = tf.reshape(damage, [-1])
        cycles = tf.reshape(cycles, [-1])
        idx = tf.argsort(cycles)
        sorted_damage = tf.gather(damage, idx)
        violations = tf.nn.relu(sorted_damage[:-1] - sorted_damage[1:])
        return tf.reduce_mean(violations)
    @tf.function 
    def consistency_loss(self, damage, rul):
        damage = tf.reshape(damage, [-1])
        rul = tf.reshape(rul, [-1])
        eps = 1e-6
        damage_norm = (damage - tf.reduce_min(damage)) / (tf.reduce_max(damage) - tf.reduce_min(damage) + eps)
        return tf.reduce_mean(tf.square(damage_norm + rul - 1.0))
    @tf.function 
    def paris_law_loss(self, damage, cycles):
        if tf.size(damage) < 2:
            return tf.constant(0.0)
        
        damage = tf.reshape(damage, [-1])
        cycles = tf.reshape(cycles, [-1])
        
        idx = tf.argsort(cycles)
        sorted_damage = tf.gather(damage, idx)
        sorted_cycles = tf.gather(cycles, idx)
        
        delta_damage = sorted_damage[1:] - sorted_damage[:-1]
        delta_cycles = sorted_cycles[1:] - sorted_cycles[:-1] + 1e-6
        growth_rate = delta_damage / delta_cycles
        
        C = 1e-6
        m = 3.0
        expected_growth = C * (sorted_damage[:-1] ** (m/2))
        
        return tf.reduce_mean(tf.square(growth_rate - expected_growth))

