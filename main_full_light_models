# GRADIENT REVERSAL LAYER (FOR DANN)
# =============================================

class GradientReversalLayer(layers.Layer):
    """
    Gradient Reversal Layer for Domain-Adversarial Neural Networks.
    During forward pass: identity
    During backward pass: gradient is multiplied by -alpha
    """
    def __init__(self, alpha=1.0, **kwargs):
        super().__init__(**kwargs)
        self.alpha = alpha
    
    def call(self, inputs):
        @tf.custom_gradient
        def reverse_gradient(x):
            def grad(dy):
                return -self.alpha * dy
            return x, grad
        return reverse_gradient(inputs)
    
    def get_config(self):
        config = super().get_config()
        config.update({'alpha': self.alpha})
        return config


