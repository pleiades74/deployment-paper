class PaderbornMultimodalLoader:
    def __init__(self, root: str, config):
        self.root = root
        self.config = config
        self.extractor = FeatureExtractor()
        self.rng = np.random.RandomState(config.random_state)
    def extract_mat_data(self, mat_path: str) -> dict:
        try:
            mat = sio.loadmat(mat_path)
            var_name = None
            for key in mat.keys():
                if key.startswith('N') and not key.startswith('__'):
                    var_name = key
                    break
            if var_name is None:
                return None
            
            data_struct = mat[var_name]
            if data_struct.shape == (1, 1):
                data_struct = data_struct[0, 0]
            
            result = {'vibration': None, 'current_1': None, 'current_2': None, 
                     'temperature': None, 'class': None, 'severity': 0}
            
            if hasattr(data_struct, 'dtype') and 'Y' in data_struct.dtype.names:
                Y = data_struct['Y']
                if Y.shape == (1, 7):
                    for i in range(Y.shape[1]):
                        item = Y[0, i]
                        name = item['Name'][0] if item['Name'].size > 0 else f"signal_{i}"
                        data_arr = item['Data']
                        if hasattr(data_arr, 'shape') and data_arr.size > 0:
                            signal = data_arr.flatten().astype(np.float32)
                            if name == 'vibration_1':
                                result['vibration'] = signal
                            elif name == 'phase_current_1':
                                result['current_1'] = signal
                            elif name == 'phase_current_2':
                                result['current_2'] = signal
                            elif name == 'temp_2_bearing_module':
                                result['temperature'] = signal
            
            if result['vibration'] is None and hasattr(data_struct, 'dtype') and 'X' in data_struct.dtype.names:
                X = data_struct['X']
                for i in range(X.shape[1]):
                    item = X[0, i]
                    data_arr = item['Data']
                    if hasattr(data_arr, 'shape') and data_arr.size > 0:
                        result['vibration'] = data_arr.flatten().astype(np.float32)
                        break
            
            if result['vibration'] is None:
                return None
            
            vib_len = len(result['vibration'])
            if result['current_1'] is None:
                result['current_1'] = np.zeros(vib_len, dtype=np.float32)
            if result['current_2'] is None:
                result['current_2'] = np.zeros(vib_len, dtype=np.float32)
            if result['temperature'] is None or len(result['temperature']) == 0:
                result['temperature'] = np.zeros(vib_len, dtype=np.float32)
            elif len(result['temperature']) < vib_len:
                result['temperature'] = np.interp(np.linspace(0, 1, vib_len),
                                                  np.linspace(0, 1, len(result['temperature'])),
                                                  result['temperature']).astype(np.float32)
            
            path_lower = mat_path.lower()
            if 'healthy' in path_lower:
                result['class'] = 'Normal'
                result['severity'] = 0
            elif 'artificial' in path_lower:
                result['class'] = 'OuterRace' if 'ka' in path_lower else 'InnerRace'
                result['severity'] = 2
            elif 'time' in path_lower:
                result['class'] = 'InnerRace' if 'ki' in path_lower else 'OuterRace'
                result['severity'] = 3
            
            return result
        except:
            return None
    
    def load_balanced_subset(self, total_files=250, max_windows_per_file=50):
        all_vib, all_ews, all_classes, all_severity, all_files = [], [], [], [], []
        
        healthy_files = []
        artificial_files = []
        time_files = []
        
        for subfolder in ['healthy', 'artificial', 'time']:
            subpath = os.path.join(self.root, subfolder)
            if os.path.exists(subpath):
                for root, dirs, files in os.walk(subpath):
                    for file in files:
                        if file.endswith('.mat'):
                            fpath = os.path.join(root, file)
                            if 'healthy' in fpath.lower():
                                healthy_files.append(fpath)
                            elif 'artificial' in fpath.lower():
                                artificial_files.append(fpath)
                            elif 'time' in fpath.lower():
                                time_files.append(fpath)
        
        print(f"  Found: {len(healthy_files)} healthy, {len(artificial_files)} artificial, {len(time_files)} time")
        
        files_per_category = total_files // 3
        remaining = total_files % 3
        
        selected_files = []
        categories = [('healthy', healthy_files), ('artificial', artificial_files), ('time', time_files)]
        
        for i, (cat_name, cat_files) in enumerate(categories):
            n_to_take = files_per_category + (1 if i < remaining else 0)
            n_to_take = min(n_to_take, len(cat_files))
            
            if n_to_take > 0 and len(cat_files) > 0:
                # ========== FIX: Use local RNG ==========
                sampled = self.rng.choice(len(cat_files), n_to_take, replace=False)
                sampled_files = [cat_files[idx] for idx in sampled]
                selected_files.extend(sampled_files)
                print(f"    Selected {len(sampled_files)} files from {cat_name}")
        
        print(f"  Total selected: {len(selected_files)} files")
        
        loaded_count = 0
        for fpath in selected_files:
            data = self.extract_mat_data(fpath)
            if data and data['vibration'] is not None:
                vib = data['vibration']
                if len(vib) >= self.config.window_size:
                    current_1 = data['current_1']
                    current_2 = data['current_2']
                    temperature = data['temperature']
                    
                    total_windows = (len(vib) - self.config.window_size) // self.config.stride + 1
                    windows_to_take = min(max_windows_per_file, total_windows)
                    
                    if windows_to_take < total_windows:
                        step = total_windows // windows_to_take
                        start_positions = list(range(0, total_windows, step))[:windows_to_take]
                    else:
                        start_positions = range(total_windows)
                    
                    for start_idx in start_positions:
                        start = start_idx * self.config.stride
                        vib_win = vib[start:start+self.config.window_size]
                        cur1_win = current_1[start:start+self.config.window_size]
                        cur2_win = current_2[start:start+self.config.window_size]
                        temp_win = temperature[start:start+self.config.window_size]
                        
                        raw_win = np.stack([vib_win, cur1_win, cur2_win, temp_win], axis=1)
                        feats = self.extractor.ews_features(vib_win)
                        
                        all_vib.append(raw_win)
                        all_ews.append(feats)
                        all_classes.append(data['class'])
                        all_severity.append(data['severity'])
                        all_files.append(fpath)
                    
                    loaded_count += 1
        
        print(f"  ✅ Loaded {loaded_count} files, Created {len(all_vib)} windows")
        
        if not all_vib:
            print(f"  ❌ No Paderborn data loaded! Check path: {self.root}")
            print(f"  Healthy files: {len(healthy_files)}, Artificial: {len(artificial_files)}, Time: {len(time_files)}")
            return np.array([]), np.array([]), np.array([]), np.array([]), [], []
        
        return (np.array(all_vib, dtype=np.float32),
                np.array(all_ews, dtype=np.float32),
                np.array(all_classes),
                np.array(all_severity, dtype=np.float32),
                all_files,
                [])


