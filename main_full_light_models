    def load_train_data(self, max_windows=2000, use_learning_set=True):
        """
        Load Pronostia data with REAL RUL values
        FIXED: Loads from ALL bearings, not just the first one
        """
        if use_learning_set:
            search_path = os.path.join(self.root, "Learning_set", "**", "acc_*.csv")
            print(f"  Loading from Learning_set")
        else:
            search_path = os.path.join(self.root, "Full_Test_Set", "**", "acc_*.csv")
            print(f"  Loading from Full_Test_Set")
        
        acc_files = sorted(glob.glob(search_path, recursive=True))  # ← ADD sorted()

        
        if not acc_files:
            return np.array([]), np.array([]), np.array([]), np.array([]), np.array([]), np.array([])
        
        # Group files by bearing
        bearing_files = defaultdict(list)
        for f in acc_files:
            parent = os.path.basename(os.path.dirname(f))
            bearing_files[parent].append(f)
        for bearing in bearing_files:
            bearing_files[bearing] = sorted(bearing_files[bearing])
        
        print(f"  Found {len(bearing_files)} bearings: {list(bearing_files.keys())}")
        
        all_windows, all_features, all_rul, all_bearings, all_temporal_positions = [], [], [], [], []
        
        # =============================================
        # FIX: Calculate samples per bearing
        # =============================================
        n_bearings = len(bearing_files)
        
        # For test set, we want to load from ALL bearings evenly
        if not use_learning_set:
            # Distribute max_windows across all bearings
            samples_per_bearing = max(1, max_windows // n_bearings)
            print(f"  Taking {samples_per_bearing} samples per bearing ({n_bearings} bearings)")
        else:
            # For training, we want as much data as possible from all bearings
            samples_per_bearing = max_windows  # Will cap per bearing
        
        # =============================================
        # Process each bearing
        # =============================================
        for bearing_name in sorted(bearing_files.keys()):
            files = sorted(bearing_files[bearing_name])
            n_samples = len(files)
            
            # Determine total life
            total_life = n_samples
            if bearing_name in self.bearing_life_map:
                mapped_life = self.bearing_life_map[bearing_name]
                if abs(mapped_life - n_samples) / n_samples < 0.1:
                    total_life = mapped_life
                else:
                    print(f"    ⚠️ Bearing {bearing_name}: Map says {mapped_life}, but found {n_samples} files. Using {n_samples}")
                    total_life = n_samples
            
            print(f"    Bearing {bearing_name}: {n_samples} samples, total life: {total_life}")
            
            # Determine how many samples to take from this bearing
            if use_learning_set:
                # Training: Take as many as possible (up to max_windows total)
                take_count = min(n_samples, max_windows - len(all_windows))
            else:
                # Test: Take evenly from all bearings
                take_count = min(samples_per_bearing, n_samples)
            
            # Select samples (take evenly spaced for test set)
            if take_count < n_samples and not use_learning_set:
                step = n_samples // take_count
                indices_to_take = list(range(0, n_samples, step))[:take_count]
            else:
                indices_to_take = range(min(n_samples, take_count))
            
            bearing_samples_taken = 0
            for i in indices_to_take:
                if len(all_windows) >= max_windows and use_learning_set:
                    break
                    
                try:
                    fpath = files[i]
                    
                    # Read CSV file
                    with open(fpath, 'r') as f:
                        first_line = f.readline().strip()
                    delimiter = ';' if ';' in first_line else ','
                    df = pd.read_csv(fpath, header=None, delimiter=delimiter)
                    data = df.values.astype(np.float32)
                    
                    # Extract vibration signals
                    if data.shape[1] >= 6:
                        vib_h = data[:, 4]
                        vib_v = data[:, 5]
                    elif data.shape[1] >= 2:
                        vib_h = data[:, 0]
                        vib_v = data[:, 1]
                    else:
                        continue
                    
                    # Handle window size
                    if len(vib_h) > self.config.window_size:
                        vib_h = vib_h[:self.config.window_size]
                        vib_v = vib_v[:self.config.window_size]
                    elif len(vib_h) < self.config.window_size:
                        pad = self.config.window_size - len(vib_h)
                        vib_h = np.pad(vib_h, (0, pad))
                        vib_v = np.pad(vib_v, (0, pad))
                    
                    raw_win = np.stack([vib_h, vib_v], axis=1)
                    feats = self.extractor.extract_features_from_multichannel(raw_win)
                    
                    # Calculate RUL
                    current_time = i
                    rul = max(0.0, min(1.0, (total_life - current_time) / total_life))
                    temporal_pos = current_time / total_life
                    
                    all_windows.append(raw_win)
                    all_features.append(feats)
                    all_rul.append(rul)
                    all_bearings.append(bearing_name)
                    all_temporal_positions.append(temporal_pos)
                    bearing_samples_taken += 1
                    
                except Exception as e:
                    continue
            
            print(f"      Loaded {bearing_samples_taken} windows from {bearing_name}")
            
            if len(all_windows) >= max_windows and use_learning_set:
                break
        
        if not all_windows:
            return np.array([]), np.array([]), np.array([]), np.array([]), np.array([]), np.array([])
        
        # Convert to numpy arrays
        all_windows = np.array(all_windows, dtype=np.float32)
        all_features = np.array(all_features, dtype=np.float32)
        all_rul = np.array(all_rul, dtype=np.float32)
        all_bearings = np.array(all_bearings)
        all_temporal_positions = np.array(all_temporal_positions, dtype=np.float32)
        
        print(f"\n  ✅ Final: {len(all_windows)} windows from {len(np.unique(all_bearings))} bearings")
        print(f"  Bearings: {list(np.unique(all_bearings))}")
        print(f"  RUL stats: min={all_rul.min():.4f}, max={all_rul.max():.4f}, mean={all_rul.mean():.4f}")
        
        return (all_windows, all_features, all_rul, 
                np.array(['pronostia'] * len(all_windows)), 
                all_bearings,
                all_temporal_positions)

