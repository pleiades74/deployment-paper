def convert_to_tflite_standard(model, config, save_path="mt_supinn_standard.tflite"):
    """
    Convert a trained Keras model directly to TensorFlow Lite format.
    Uses ONLY standard TFLite ops (NO SELECT_TF_OPS).
    This will work on Raspberry Pi without Flex delegate.
    """
    print("\n" + "="*60)
    print("CONVERTING TO TFLITE (STANDARD OPS ONLY)")
    print("="*60)
    
    print("  ✅ Using trained model directly")
    
    # ========== STANDARD CONVERSION (NO SELECT_TF_OPS) ==========
    converter = tf.lite.TFLiteConverter.from_keras_model(model)
    
    # Optional: Enable optimizations for edge deployment
    # converter.optimizations = [tf.lite.Optimize.DEFAULT]
    
    # NO SELECT_TF_OPS - this is the key difference
    # converter.target_spec.supported_ops = [tf.lite.OpsSet.TFLITE_BUILTINS]
    # =============================================================
    
    print("🔄 Converting model to standard TFLite...")
    tflite_model = converter.convert()
    
    with open(save_path, 'wb') as f:
        f.write(tflite_model)
    
    file_size_kb = len(tflite_model) / 1024
    file_size_mb = file_size_kb / 1024
    
    print(f"\n✅ Model converted successfully!")
    print(f"   Saved to: {save_path}")
    print(f"   File size: {file_size_kb:.2f} KB ({file_size_mb:.2f} MB)")
    
    # Verify the model works
    print("\n🔍 Verifying TFLite model...")
    try:
        interpreter = tf.lite.Interpreter(model_content=tflite_model)
        interpreter.allocate_tensors()
        
        input_details = interpreter.get_input_details()
        output_details = interpreter.get_output_details()
        
        print(f"   Inputs: {len(input_details)}")
        for i, inp in enumerate(input_details):
            print(f"     Input {i}: shape={inp['shape']}, dtype={inp['dtype']}")
        
        print(f"   Outputs: {len(output_details)}")
        for i, out in enumerate(output_details):
            print(f"     Output {i}: shape={out['shape']}, dtype={out['dtype']}")
        
        print("  ✅ TFLite model verified successfully!")
    except Exception as e:
        print(f"  ⚠️ Verification failed: {e}")
        print("  The model may still work on the Pi, but test it first.")
    
    return save_path
