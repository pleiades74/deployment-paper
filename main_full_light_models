def train_and_evaluate_baseline(model, train_gen, val_gen, test_gen, config, baseline_name):
    """
    Train and evaluate a baseline model.
    """
    print(f"\n  Training {baseline_name} baseline...")
    
    # Compile model
    model.compile(
        optimizer=Adam(learning_rate=config.learning_rate),
        loss={
            'cwru_class': 'categorical_crossentropy',
            'paderborn_class': 'categorical_crossentropy',
            'pronostia_rul': 'mse'
        },
        loss_weights={
            'cwru_class': config.weight_cwru,
            'paderborn_class': config.weight_paderborn,
            'pronostia_rul': config.weight_pronostia_rul
        },
        metrics={
            'cwru_class': 'accuracy',
            'paderborn_class': 'accuracy'
        }
    )
    
    # Early stopping
    early_stop = EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True)
    
    # Train
    history = model.fit(
        train_gen,
        validation_data=val_gen,
        epochs=min(config.epochs, 15),  # Fewer epochs for baselines
        callbacks=[early_stop],
        verbose=0
    )
    
    # ========== FIX: Properly collect test data ==========
    # Collect all test data from generator
    all_x = []
    all_ews = []
    all_outputs = {}
    
    for i in range(len(test_gen)):
        inputs, outputs, _ = test_gen[i]
        all_x.append(inputs[0])
        all_ews.append(inputs[1])
        for key in outputs.keys():
            if key not in all_outputs:
                all_outputs[key] = []
            all_outputs[key].append(outputs[key])
    
    if not all_x:
        print(f"    ⚠️ No test data for {baseline_name}")
        return {'cwru_accuracy': 0, 'paderborn_accuracy': 0, 'pronostia_rmse': float('inf')}, history
    
    all_x = np.vstack(all_x)
    all_ews = np.vstack(all_ews)
    for key in all_outputs:
        all_outputs[key] = np.vstack(all_outputs[key])
    
    # Predict
    pred = model.predict([all_x, all_ews], verbose=0)
    
    # Calculate metrics
    results = {}
    
    # CWRU accuracy
    if 'cwru_class' in pred and 'cwru_class' in all_outputs:
        y_pred = np.argmax(pred['cwru_class'], axis=1)
        y_true = np.argmax(all_outputs['cwru_class'], axis=1)
        results['cwru_accuracy'] = np.mean(y_true == y_pred)
    else:
        results['cwru_accuracy'] = 0
    
    # Paderborn accuracy
    if 'paderborn_class' in pred and 'paderborn_class' in all_outputs:
        y_pred = np.argmax(pred['paderborn_class'], axis=1)
        y_true = np.argmax(all_outputs['paderborn_class'], axis=1)
        results['paderborn_accuracy'] = np.mean(y_true == y_pred)
    else:
        results['paderborn_accuracy'] = 0
    
    # Pronostia RMSE
    if 'pronostia_rul' in pred and 'pronostia_rul' in all_outputs:
        y_pred = pred['pronostia_rul'].flatten()
        y_true = all_outputs['pronostia_rul'].flatten()
        results['pronostia_rmse'] = np.sqrt(mean_squared_error(y_true, y_pred))
    else:
        results['pronostia_rmse'] = float('inf')
    
    print(f"    {baseline_name} - CWRU: {results['cwru_accuracy']:.4f}, "
          f"Paderborn: {results['paderborn_accuracy']:.4f}, "
          f"RMSE: {results['pronostia_rmse']:.4f}")
    
    return results, history
