                bg_ews = X_c_ews_train[:n_bg]

                # ---------------------------------------------------
                # 2. Build a single-output wrapper for SHAP
                # ---------------------------------------------------
                # SHAP's DeepExplainer works cleanly with a single
                # scalar output. We explain the CWRU classifier by
                # taking the max softmax probability across classes.
                # This gives per-sample attribution for "what drives
                # the CWRU prediction".

                @tf.function(reduce_retracing=True)
                def cwru_score(vib, ews):
                    pred = model([vib, ews], training=False)
                    return tf.reduce_max(pred['cwru_class'], axis=-1)

                # DeepExplainer expects a callable that takes a list of
                # tensors and returns a tensor.
                class CWRUScoreWrapper(tf.keras.Model):
                    def call(self, inputs):
                        vib, ews = inputs
                        return cwru_score(vib, ews)

                wrapper = CWRUScoreWrapper()

                # ---------------------------------------------------
                # 3. Run DeepExplainer
                # ---------------------------------------------------
                print("  Running SHAP DeepExplainer on CWRU test set...")
                print(f"  Background: {n_bg} samples, Explain: {n_explain} samples")

                explainer = shap.DeepExplainer(
                    wrapper,
                    [bg_vib, bg_ews]
                )
                shap_values = explainer.shap_values(
                    [explain_vib, explain_ews],
                    check_additivity=False
                )

                # shap_values is a list [shap_vib, shap_ews] each with
                # shape (n_explain, window, channels) or (n_explain, 11).
