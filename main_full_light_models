# [FIX-W3] SINGLE-TASK BASELINE TRAINER
# =============================================

def run_single_task_baselines(config, train_data, test_data):
    """
    [FIX-W3] Train three independent single-task models and export them as TFLite
    for aggregate-cost comparison on the Pi.

    Args:
        config: MultiModalConfig instance
        train_data: dict with keys 'cwru', 'paderborn', 'pronostia', each a tuple:
                    (X_vib, X_ews, y_target)
        test_data:  dict with same keys, each a tuple:
                    (X_vib, X_ews, y_target)

    Outputs:
        - single_task_cwru.tflite
        - single_task_paderborn.tflite
        - single_task_pronostia.tflite
        - single_task_baseline_results.json
    """
    from tensorflow.keras.callbacks import EarlyStopping

    print("\n" + "="*80)
    print("SINGLE-TASK BASELINE TRAINING [FIX-W3]")
    print("="*80)

    results = {}

        # ---- 1. CWRU single-task classifier (3-class, matches multi-task) ----
    print("\n📊 Training CWRU-only classifier (3-class, no Ball)...")
    X_c_vib, X_c_ews, y_c = train_data['cwru']
    X_c_vib_test, X_c_ews_test, y_c_test = test_data['cwru']

    # ---------------------------------------------------------------
    # Remap CWRU 4-class to 3-class matching the multi-task setup:
    #   Normal (0)      -> 0
    #   Ball (1)        -> DROP
    #   InnerRace (2)   -> 1
    #   OuterRace (3)   -> 2
    # ---------------------------------------------------------------
    def _remap_cwru_4to3(y_onehot, mask_labels):
        """Keep classes {0, 2, 3}, reindex to {0, 1, 2}, drop class 1."""
        y_int = np.argmax(y_onehot, axis=1)
        keep_mask = np.isin(y_int, [0, 2, 3])
        y_int_kept = y_int[keep_mask]
        # remap: 0->0, 2->1, 3->2
        remap = {0: 0, 2: 1, 3: 2}
        y_int_new = np.array([remap[v] for v in y_int_kept], dtype=np.int32)
        y_new = tf.keras.utils.to_categorical(y_int_new, 3)
        return y_new, keep_mask

    y_c_train_3, train_keep = _remap_cwru_4to3(y_c, [0, 2, 3])
    y_c_test_3, test_keep  = _remap_cwru_4to3(y_c_test, [0, 2, 3])

    X_c_vib_train = X_c_vib[train_keep]
    X_c_ews_train = X_c_ews[train_keep]
    X_c_vib_test_kept = X_c_vib_test[test_keep]
    X_c_ews_test_kept = X_c_ews_test[test_keep]

    print(f"  Train kept: {train_keep.sum()}/{len(train_keep)} (dropped {(~train_keep).sum()} Ball samples)")
    print(f"  Test kept:  {test_keep.sum()}/{len(test_keep)} (dropped {(~test_keep).sum()} Ball samples)")

    # NEW: refit scaler on CWRU-only training EWS (fixes the -0.47 mean issue)
    from sklearn.preprocessing import StandardScaler as _SS
    _cwru_scaler = _SS()
    X_c_ews_train = _cwru_scaler.fit_transform(X_c_ews_train)
    X_c_ews_test_kept = _cwru_scaler.transform(X_c_ews_test_kept)
    print(f"  After CWRU-specific scaling: mean={X_c_ews_train.mean():.4f}, std={X_c_ews_train.std():.4f}")

    st_cwru = build_single_task_model(config, 'cwru', n_classes=3, task_type='classification')
    st_cwru.compile(optimizer=Adam(learning_rate=config.learning_rate),
                    loss='categorical_crossentropy', metrics=['accuracy'])

    X_c_train_p = np.pad(X_c_vib_train, ((0,0),(0,0),(0,1)))
    X_c_test_p = np.pad(X_c_vib_test_kept, ((0,0),(0,0),(0,1)))

    st_cwru.fit([X_c_train_p, X_c_ews_train], y_c_train_3,
                validation_split=0.1, epochs=35, batch_size=128, verbose=1,
                callbacks=[EarlyStopping(patience=10, restore_best_weights=True)])

    pred_c = st_cwru.predict([X_c_test_p, X_c_ews_test_kept], verbose=0)
    acc_c = float(np.mean(np.argmax(pred_c, axis=1) == np.argmax(y_c_test_3, axis=1)))
    results['cwru_single_task_accuracy'] = acc_c
    print(f"  ✅ CWRU single-task accuracy (3-class): {acc_c:.4f}")

    # Debug
    print(f"  Train pred dist: {np.bincount(np.argmax(pred_c, axis=1), minlength=3)}")
    print(f"  Train true dist: {np.bincount(np.argmax(y_c_test_3, axis=1), minlength=3)}")

    # ---- 2. Paderborn single-task classifier ----
    print("\n📊 Training Paderborn-only classifier...")
    X_p_vib, X_p_ews, y_p = train_data['paderborn']
    X_p_vib_test, X_p_ews_test, y_p_test = test_data['paderborn']

    st_pader = build_single_task_model(config, 'paderborn', n_classes=3, task_type='classification')
    st_pader.compile(optimizer=Adam(learning_rate=config.learning_rate),
                     loss='categorical_crossentropy', metrics=['accuracy'])

    st_pader.fit([X_p_vib, X_p_ews], y_p,
                 validation_split=0.1, epochs=35, batch_size=128, verbose=0,
                 callbacks=[EarlyStopping(patience=10, restore_best_weights=True)])

    pred_p = st_pader.predict([X_p_vib_test, X_p_ews_test], verbose=0)
    acc_p = float(np.mean(np.argmax(pred_p, axis=1) == np.argmax(y_p_test, axis=1)))
    results['paderborn_single_task_accuracy'] = acc_p
    print(f"  ✅ Paderborn single-task accuracy: {acc_p:.4f}")

    # ---- 3. Pronostia single-task regressor ----
    print("\n📊 Training Pronostia-only regressor...")
    X_pr_vib, X_pr_ews, y_pr = train_data['pronostia']
    X_pr_vib_test, X_pr_ews_test, y_pr_test = test_data['pronostia']

    st_prono = build_single_task_model(config, 'pronostia', task_type='regression')
    st_prono.compile(optimizer=Adam(learning_rate=config.learning_rate),
                     loss='mse', metrics=['mae'])

    # Pad Pronostia 2-ch to 4-ch
    X_pr_train_p = np.pad(X_pr_vib, ((0,0),(0,0),(0,2)))
    X_pr_test_p = np.pad(X_pr_vib_test, ((0,0),(0,0),(0,2)))

    st_prono.fit([X_pr_train_p, X_pr_ews], y_pr,
                 validation_split=0.1, epochs=35, batch_size=128, verbose=0,
                 callbacks=[EarlyStopping(patience=10, restore_best_weights=True)])

    pred_r = st_prono.predict([X_pr_test_p, X_pr_ews_test], verbose=0).flatten()
    rmse_r = float(np.sqrt(mean_squared_error(y_pr_test, pred_r)))
    results['pronostia_single_task_rmse'] = rmse_r
    print(f"  ✅ Pronostia single-task RMSE: {rmse_r:.4f}")

    # ---- 4. Export 3 TFLite files for Pi deployment ----
    print("\n💾 Converting single-task models to TFLite...")
    for name, mdl in [('cwru', st_cwru), ('paderborn', st_pader), ('pronostia', st_prono)]:
        try:
            conv = tf.lite.TFLiteConverter.from_keras_model(mdl)
            conv.target_spec.supported_ops = [
                tf.lite.OpsSet.TFLITE_BUILTINS,
                tf.lite.OpsSet.SELECT_TF_OPS
            ]
            conv._experimental_lower_tensor_list_ops = False
            tfl = conv.convert()
            fname = f'single_task_{name}.tflite'
            with open(fname, 'wb') as f:
                f.write(tfl)
            size_kb = len(tfl) / 1024
            results[f'{name}_single_task_size_kb'] = size_kb
            print(f"  ✅ {fname}: {size_kb:.2f} KB")
        except Exception as e:
            print(f"  ❌ Failed to convert {name}: {e}")
            results[f'{name}_single_task_size_kb'] = -1

    # ---- 5. Aggregate cost summary ----
    total_size = sum(v for k, v in results.items() if k.endswith('_size_kb') and v > 0)
    results['aggregate_size_kb'] = total_size
    print(f"\n  📊 Aggregate size of 3 single-task models: {total_size:.2f} KB")
    print(f"  📊 Compare against single MT-SUPINN: 236–747 KB")

    # ---- 6. Save results ----
    with open('single_task_baseline_results.json', 'w') as f:
        json.dump(results, f, indent=2)
    print(f"  ✅ Saved: single_task_baseline_results.json")

    return results

