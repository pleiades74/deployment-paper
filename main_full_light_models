class MultiModalTrainer:
    def __init__(self, model, config):

        self.model = model
        self.config = config
        self.optimizer = Adam(learning_rate=config.learning_rate, clipnorm=1.0)
        self.physics = PhysicsLosses(config)
        self.cluster_centers = None    
        self.current_epoch = 0  # ← ADD THIS

        
    
    def clustering_loss(self, embeddings):
        if self.cluster_centers is None:
            return tf.constant(0.0)
        embeddings_norm = tf.math.l2_normalize(embeddings, axis=-1)
        centers_norm = tf.math.l2_normalize(self.cluster_centers, axis=-1)
        distances = tf.matmul(embeddings_norm, centers_norm, transpose_b=True)
        soft_assign = tf.nn.softmax(distances / 1.0)
        target = soft_assign ** 2 / (tf.reduce_sum(soft_assign, axis=0) + 1e-10)
        target = target / (tf.reduce_sum(target, axis=-1, keepdims=True) + 1e-10)
        return tf.reduce_mean(tf.reduce_sum(target * tf.math.log(target / (soft_assign + 1e-10)), axis=-1))

    
    # ADD THIS DECORATOR - BUT WITH CAUTION
    @tf.function(reduce_retracing=True)
    def train_step(self, inputs, outputs, extra, is_training=True):
        x_in, ews_in = inputs
        
        y_cwru = tf.convert_to_tensor(outputs['cwru_class'], dtype=tf.float32)
        y_paderborn = tf.convert_to_tensor(outputs['paderborn_class'], dtype=tf.float32)
        y_rul = tf.convert_to_tensor(outputs['pronostia_rul'], dtype=tf.float32)
        
        dataset = tf.convert_to_tensor(extra['dataset'], dtype=tf.int32)
        cycles = tf.convert_to_tensor(extra['cycles'], dtype=tf.float32)
        domain = tf.convert_to_tensor(extra['domain'], dtype=tf.int32)  # ← ADD THIS

        x_in = tf.cast(x_in, tf.float32)
        ews_in = tf.cast(ews_in, tf.float32)
        
        cwru_mask = tf.cast(tf.equal(dataset, 0), tf.float32)
        paderborn_mask = tf.cast(tf.equal(dataset, 1), tf.float32)
        pronostia_mask = tf.cast(tf.equal(dataset, 2), tf.float32)
        
        with tf.GradientTape() as tape:
            pred = self.model([x_in, ews_in], training=True)
            
            y_cwru_reshaped = tf.reshape(y_cwru, [-1, 4])
            y_paderborn_reshaped = tf.reshape(y_paderborn, [-1, 3])
            
            if self.config.use_focal_loss:
                focal = FocalLoss(gamma=self.config.focal_gamma)
                loss_paderborn = tf.reduce_mean(paderborn_mask * focal(y_paderborn_reshaped, pred['paderborn_class']))
            else:
                loss_paderborn = tf.reduce_mean(paderborn_mask * tf.keras.losses.categorical_crossentropy(
                    y_paderborn_reshaped, pred['paderborn_class']))
            
            loss_cwru = tf.reduce_mean(cwru_mask * tf.keras.losses.categorical_crossentropy(
                y_cwru_reshaped, pred['cwru_class']))
            
            y_rul_reshaped = tf.reshape(y_rul, [-1])
            pred_rul = tf.reshape(pred['pronostia_rul'], [-1])
            rul_error = y_rul_reshaped - pred_rul
            huber_delta = 0.1
            loss_rul = tf.reduce_mean(pronostia_mask * tf.where(
                tf.abs(rul_error) < huber_delta,
                0.5 * tf.square(rul_error),
                huber_delta * (tf.abs(rul_error) - 0.5 * huber_delta)
            ))
            
            damage = tf.reshape(pred['shared_damage'], [-1])
            
            pron_indices = tf.where(pronostia_mask > 0)[:, 0]
            
            if tf.size(pron_indices) >= 1:
                damage_pron = tf.gather(damage, pron_indices)
                cycles_pron = tf.gather(cycles, pron_indices)
                rul_pron = tf.gather(y_rul_reshaped, pron_indices)
                
                if tf.size(pron_indices) == 1:
                    damage_pron = tf.concat([damage_pron, damage_pron], axis=0)
                    cycles_pron = tf.concat([cycles_pron, cycles_pron + 0.001], axis=0)
                    rul_pron = tf.concat([rul_pron, rul_pron], axis=0)
                
                mono_loss = self.physics.monotonicity_loss(damage_pron, cycles_pron)
                consist_loss = self.physics.consistency_loss(damage_pron, rul_pron)
                paris_loss = self.physics.paris_law_loss(damage_pron, cycles_pron)
            else:
                mono_loss = tf.constant(0.0)
                consist_loss = tf.constant(0.0)
                paris_loss = tf.constant(0.0)

            # ========== ADD CLUSTER LOSS ==========
            if is_training and self.cluster_centers is not None:
                cluster_loss = self.clustering_loss(pred['cluster_embedding'])
            else:
                cluster_loss = tf.constant(0.0)
            # ========== END CLUSTER LOSS ==========

            
            # ========== DOMAIN LOSS (DANN) ==========
            # Check if DANN should be disabled
            # ========== DOMAIN LOSS (DANN) ==========
            # Check if DANN should be disabled
            use_dann = hasattr(self.config, 'use_dann') and self.config.use_dann
            
            # ========== DOMAIN LOSS (DANN) ==========
            if use_dann:
                cwru_mask = tf.equal(dataset, 0)
                paderborn_mask = tf.equal(dataset, 1)
                domain_mask = tf.cast(tf.logical_or(cwru_mask, paderborn_mask), tf.float32)
                
                # ========== FIX: Cleaner domain labels ==========
                # Initialize with zeros
                domain_labels = tf.zeros((tf.shape(dataset)[0], 2), dtype=tf.float32)
                
                # CWRU = [1.0, 0.0]
                domain_labels = tf.where(
                    tf.expand_dims(cwru_mask, -1),
                    tf.constant([[1.0, 0.0]], dtype=tf.float32),
                    domain_labels
                )
                # Paderborn = [0.0, 1.0]
                domain_labels = tf.where(
                    tf.expand_dims(paderborn_mask, -1),
                    tf.constant([[0.0, 1.0]], dtype=tf.float32),
                    domain_labels
                )
                domain_labels = tf.cast(domain_labels, tf.float32)
                
                # Domain classifier loss (categorical cross-entropy)
                domain_loss = tf.reduce_mean(domain_mask * tf.keras.losses.categorical_crossentropy(
                    domain_labels, pred['domain']
                ))
                domain_loss_weight = 0.1
            else:
                domain_loss = tf.constant(0.0)
                domain_loss_weight = 0.0
            # ========== END FIX ==========

            total_loss = (self.config.weight_cwru * loss_cwru + 
                          self.config.weight_paderborn * loss_paderborn + 
                          self.config.weight_pronostia_rul * loss_rul + 
                          self.config.alpha_mono * mono_loss + 
                          self.config.gamma_consist * consist_loss + 
                          self.config.beta_paris * paris_loss + 
                          self.config.cluster_loss_weight * cluster_loss +
                          domain_loss_weight * domain_loss)  # Will be 0 if DANN disabled
                    
        grads = tape.gradient(total_loss, self.model.trainable_variables)
        grads = [g if g is not None else tf.zeros_like(v) for g, v in zip(grads, self.model.trainable_variables)]
        self.optimizer.apply_gradients(zip(grads, self.model.trainable_variables))
        
        return {
            'loss': total_loss, 
            'cwru_loss': loss_cwru,
            'paderborn_loss': loss_paderborn, 
            'rul_loss': loss_rul,
            'mono_loss': mono_loss,
            'cluster_loss': cluster_loss,
            'domain_loss': domain_loss if use_dann else tf.constant(0.0) # Return 0 if disabled
        }
                    
    def predict_with_uncertainty(self, inputs, n_passes=100):
        import time
        print(f"  Running {n_passes} MC Dropout passes...")
        start_time = time.time()
        
        predictions = []
        for i in range(n_passes):
            pred = self.model(inputs, training=True)
            predictions.append(pred['pronostia_rul'].numpy())
        
        predictions = np.array(predictions)
        mean = np.mean(predictions, axis=0)
        std = np.std(predictions, axis=0)
        ci_lower = mean - 1.96 * std
        ci_upper = mean + 1.96 * std
        
        elapsed = time.time() - start_time
        print(f"  Completed in {elapsed:.2f} seconds")
        
        return mean, std, ci_lower, ci_upper
    
    # =============================================
    # CLUSTER CENTER INITIALIZATION - FIXED
    # =============================================
    
    def initialize_cluster_centers(self, generator, num_clusters=5, wait_epochs=5):
        """
        Initialize cluster centers AFTER the model has been trained for a few epochs.
        
        Args:
            generator: Data generator for collecting embeddings
            num_clusters: Number of clusters
            wait_epochs: Number of epochs to wait before initializing
        """
        # This should be called after training for wait_epochs
        print(f"\n🔧 Initializing cluster centers after {wait_epochs} epochs of training...")
        
        all_embeddings = []
        sample_count = 0
        target_samples = min(1000, len(generator) * 32)  # Collect up to 1000 samples
        
        for batch_idx in range(min(len(generator), 20)):  # Max 20 batches
            inputs, outputs, extra = generator[batch_idx]
            pred = self.model.predict(inputs, verbose=0)
            embeddings = pred['cluster_embedding']
            all_embeddings.append(embeddings)
            sample_count += len(embeddings)
            
            if sample_count >= target_samples:
                break
        
        all_embeddings = np.vstack(all_embeddings)[:target_samples]
        
        # Use K-means++ initialization
        from sklearn.cluster import KMeans
        kmeans = KMeans(n_clusters=num_clusters, random_state=CURRENT_SEED, n_init=10, init='k-means++')
        kmeans.fit(all_embeddings)
        
        self.cluster_centers = tf.constant(kmeans.cluster_centers_, dtype=tf.float32)
        
        # Calculate cluster quality
        from sklearn.metrics import silhouette_score
        sil_score = silhouette_score(all_embeddings, kmeans.labels_)
        print(f"   ✅ Initialized {num_clusters} cluster centers")
        print(f"   Silhouette score: {sil_score:.4f}")
        
        return self.cluster_centers
            

