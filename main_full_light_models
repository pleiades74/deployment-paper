        self.config = config
        # ========== FIX: Create local RNG ==========
        self.rng = np.random.RandomState(config.random_state if config else 42)
        self.indices = []
        
        if cwru_data is not None and len(cwru_data[0]) > 0:
            print(f"  ✅ Adding CWRU: {len(cwru_data[0])} samples")
            for i in range(len(cwru_data[0])):
                self.indices.append((0, i))
        if paderborn_data is not None and len(paderborn_data[0]) > 0:
            print(f"  ✅ Adding Paderborn: {len(paderborn_data[0])} samples")
            for i in range(len(paderborn_data[0])):
                self.indices.append((1, i))
        if pronostia_data is not None and len(pronostia_data[0]) > 0:
            print(f"  ✅ Adding Pronostia: {len(pronostia_data[0])} samples")
            for i in range(len(pronostia_data[0])):
                self.indices.append((2, i))
        
        print(f"  Total samples: {len(self.indices)}")
        self.on_epoch_end()
        
    def __len__(self):
        return (len(self.indices) + self.batch_size - 1) // self.batch_size
    
    def __getitem__(self, idx):
        start = idx * self.batch_size
        end = min(start + self.batch_size, len(self.indices))
        batch_indices = self.indices[start:end]
        batch_size_actual = len(batch_indices)
        
        cwru_array = np.zeros((batch_size_actual, 4), dtype=np.float32)
        paderborn_array = np.zeros((batch_size_actual, 3), dtype=np.float32)
        rul_array = np.zeros((batch_size_actual,), dtype=np.float32)
        dataset_array = np.zeros((batch_size_actual,), dtype=np.int32)
        domain_array = np.zeros((batch_size_actual,), dtype=np.int32)
        
        cycles_array = np.zeros((batch_size_actual,), dtype=np.float32)
        input_list = [None] * batch_size_actual
        ews_list = [None] * batch_size_actual
        
        for i, (ds_id, sample_idx) in enumerate(batch_indices):
            if ds_id == 0:  # CWRU
                X_vib, X_ews, y_class, _, _ = self.cwru_data
                x = X_vib[sample_idx]
                padded = np.zeros((x.shape[0], 4), dtype=np.float32)
                padded[:, :3] = x
                input_list[i] = padded
                ews_list[i] = X_ews[sample_idx]
                
                one_hot = y_class[sample_idx]
                if isinstance(one_hot, (int, np.integer)):
                    one_hot = np.zeros(4, dtype=np.float32)
                    one_hot[y_class[sample_idx]] = 1.0
                cwru_array[i] = one_hot.astype(np.float32)
                dataset_array[i] = 0
                domain_array[i] = 0
                cycles_array[i] = 0
                
            elif ds_id == 1:  # Paderborn
                X_vib, X_ews, y_class, _, _ = self.paderborn_data
                input_list[i] = X_vib[sample_idx]
                ews_list[i] = X_ews[sample_idx]
                
                label = y_class[sample_idx]
                if isinstance(label, (int, np.integer)):
                    label = np.zeros(3, dtype=np.float32)
                    label[y_class[sample_idx]] = 1.0
                paderborn_array[i] = label.astype(np.float32)
                dataset_array[i] = 1
                domain_array[i] = 1
                cycles_array[i] = 0
                
            else:  # Pronostia
                X_vib, X_ews, y_rul, _, _, temporal_pos = self.pronostia_data
                x = X_vib[sample_idx]
                padded = np.zeros((x.shape[0], 4), dtype=np.float32)
                padded[:, :2] = x
                input_list[i] = padded
                ews_list[i] = X_ews[sample_idx]
                rul_array[i] = float(y_rul[sample_idx])
                dataset_array[i] = 2
                domain_array[i] = 2
                cycles_array[i] = temporal_pos[sample_idx]
        
        input_array = np.stack(input_list, axis=0)
        ews_array = np.array(ews_list, dtype=np.float32)
        
        return ([input_array, ews_array],
                {'cwru_class': cwru_array,
                 'paderborn_class': paderborn_array,
                 'pronostia_rul': rul_array,
                 'shared_damage': np.zeros((batch_size_actual, 1), dtype=np.float32)},
                {'dataset': dataset_array,
                 'domain': domain_array,
                 'cycles': cycles_array})
    
    def on_epoch_end(self):
        if self.shuffle:
            self.rng.shuffle(self.indices)
