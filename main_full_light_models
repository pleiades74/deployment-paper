class FocalLoss(tf.keras.losses.Loss):
    """
    Focal Loss for imbalanced classification.
    Paper: "Focal Loss for Dense Object Detection" (Lin et al., 2017)
    """
    def __init__(self, gamma=2.0, alpha=None, name='focal_loss'):
        """
        Args:
            gamma: Focusing parameter (default 2.0)
            alpha: Class weighting factor. If None, no class weighting.
        """
        super().__init__(name=name)
        self.gamma = gamma
        self.alpha = alpha
    
    def call(self, y_true, y_pred):
        """
        Compute focal loss.
        
        Args:
            y_true: One-hot encoded true labels [batch, num_classes]
            y_pred: Predicted probabilities [batch, num_classes]
        """
        # Compute cross-entropy
        ce = tf.keras.losses.categorical_crossentropy(y_true, y_pred, from_logits=False)
        
        # Compute pt (probability of true class)
        pt = tf.exp(-ce)
        
        # Compute focal weight: (1 - pt)^gamma
        focal_weight = (1 - pt) ** self.gamma
        
        # Apply class weighting if provided
        if self.alpha is not None:
            # If alpha is a single value, broadcast to all classes
            if isinstance(self.alpha, float):
                # For binary classification with alpha as scalar
                # For multi-class, alpha should be a list/array
                pass
            # If alpha is a list/array of per-class weights
            elif isinstance(self.alpha, (list, tuple, np.ndarray)):
                # Convert to tensor and reshape for broadcasting
                alpha_tensor = tf.constant(self.alpha, dtype=tf.float32)
                # Reshape to [1, num_classes] for broadcasting
                alpha_tensor = tf.reshape(alpha_tensor, (1, -1))
                # Apply class weights
                # Weighted focal loss per sample
                focal_weight = focal_weight * tf.reduce_sum(y_true * alpha_tensor, axis=-1)
        
        # Compute final loss
        loss = focal_weight * ce
        
        # Return mean loss
        return tf.reduce_mean(loss)

#######################################################################################################################################
class PhysicsDiagnosticCallback(tf.keras.callbacks.Callback):
    """
    Measures whether physics losses are contributing meaningful gradient
    signal. Self-contained: builds the shared-tensor extractor on first
    use, so it cannot fail due to missing __init__ state.
    """
    def __init__(self, trainer, generator, epochs_to_check=(1, 15, 30),
                 output_path='physics_diagnostic.txt'):
        super().__init__()
        self.trainer = trainer
        self.generator = generator
        self.epochs_to_check = set(epochs_to_check)
        self.output_path = output_path
        self.lines = []

    def _log(self, msg):
        print(msg)
        self.lines.append(msg)
        try:
            with open(self.output_path, 'w') as f:
                f.write('\n'.join(self.lines))
        except Exception as e:
            print(f"  [DIAG] could not write log: {e}")

    def _build_extractor(self):
        """Locate the shared trunk and build a sub-model that returns it."""
        model = self.trainer.model

        shared_layer = None
        # Try known names first
        for name in ['dropout_4', 'dropout_19', 'dropout_7',
                     'dropout_3', 'dropout_9', 'dropout_10']:
            try:
                shared_layer = model.get_layer(name)
                break
            except ValueError:
                continue

        # Fallback: walk graph from a layer we know consumes the shared trunk
        if shared_layer is None:
            for layer in model.layers:
                if layer.name in ('gradient_reversal', 'domain_dummy',
                                  'cluster_embedding', 'shared_damage'):
                    try:
                        inbound = layer._inbound_nodes[0].input_tensors[0]
                        shared_layer = inbound._keras_history.layer
                        break
                    except Exception:
                        continue

        if shared_layer is None:
            print("  [DIAG] ERROR: could not locate shared trunk layer")
            return None

        print(f"  [DIAG] Using shared layer: {shared_layer.name} "
              f"(shape {shared_layer.output.shape})")
        try:
            return tf.keras.Model(
                inputs=model.inputs,
                outputs=[model.output, shared_layer.output]
            )
        except Exception as e:
            print(f"  [DIAG] ERROR building extractor: {e}")
            return None

    def on_epoch_end(self, epoch, logs=None):
        if (epoch + 1) not in self.epochs_to_check:
            return

        # Build the extractor lazily (or reuse if already built)
        extractor = getattr(self, 'shared_extractor', None)
        if extractor is None:
            extractor = self._build_extractor()
            self.shared_extractor = extractor
        if extractor is None:
            self._log(f"\n[DIAG] Skipping diagnostic at epoch {epoch+1} "
                      f"(no shared extractor available)")
            return

        self._log(f"\n{'='*70}")
        self._log(f"PHYSICS DIAGNOSTIC — end of epoch {epoch+1}")
        self._log(f"{'='*70}")

        inputs, outputs, extra = self.generator[0]
        x_in, ews_in = inputs

        cfg = self.trainer.config
        physics = self.trainer.physics

        x_in = tf.cast(x_in, tf.float32)
        ews_in = tf.cast(ews_in, tf.float32)

        y_cwru = tf.convert_to_tensor(outputs['cwru_class'], tf.float32)
        y_pader = tf.convert_to_tensor(outputs['paderborn_class'], tf.float32)
        y_rul = tf.convert_to_tensor(outputs['pronostia_rul'], tf.float32)
        dataset = tf.convert_to_tensor(extra['dataset'], tf.int32)
        cycles = tf.convert_to_tensor(extra['cycles'], tf.float32)

        pron_mask = tf.cast(tf.equal(dataset, 2), tf.float32)
        cwru_mask = tf.cast(tf.equal(dataset, 0), tf.float32)
        pader_mask = tf.cast(tf.equal(dataset, 1), tf.float32)

        with tf.GradientTape(persistent=True) as tape:
            pred_dict, shared_tensor = extractor([x_in, ews_in],
                                                  training=False)
            tape.watch(shared_tensor)

            loss_cwru = tf.reduce_mean(cwru_mask * tf.keras.losses.categorical_crossentropy(
                tf.reshape(y_cwru, [-1, 4]), pred_dict['cwru_class']))
            loss_pader = tf.reduce_mean(pader_mask * tf.keras.losses.categorical_crossentropy(
                tf.reshape(y_pader, [-1, 3]), pred_dict['paderborn_class']))
            y_rul_f = tf.reshape(y_rul, [-1])
            pred_rul = tf.reshape(pred_dict['pronostia_rul'], [-1])
            err = y_rul_f - pred_rul
            loss_rul = tf.reduce_mean(pron_mask * tf.where(
                tf.abs(err) < 0.1,
                0.5 * tf.square(err),
                0.1 * (tf.abs(err) - 0.05)))

            damage = tf.reshape(pred_dict['shared_damage'], [-1])
            pron_idx = tf.where(pron_mask > 0)[:, 0]

            if tf.size(pron_idx) >= 2:
                d = tf.gather(damage, pron_idx)
                c = tf.gather(cycles, pron_idx)
                r = tf.gather(y_rul_f, pron_idx)
                mono = physics.monotonicity_loss(d, c)
                consist = physics.consistency_loss(d, r)
                paris = physics.paris_law_loss(d, c)
            else:
                mono = consist = paris = tf.constant(0.0)

            loss_physics_weighted = (cfg.alpha_mono * mono +
                                     cfg.beta_paris * paris +
                                     cfg.gamma_consist * consist)
            loss_task_weighted = (cfg.weight_cwru * loss_cwru +
                                  cfg.weight_paderborn * loss_pader +
                                  cfg.weight_pronostia_rul * loss_rul)

        # Gradients computed OUTSIDE the tape context
        grads_phys = tape.gradient(loss_physics_weighted, shared_tensor)
        grads_task = tape.gradient(loss_task_weighted, shared_tensor)
        del tape

        if grads_phys is not None and grads_task is not None:
            g_phys_norm = float(tf.norm(grads_phys).numpy())
            g_task_norm = float(tf.norm(grads_task).numpy())
            ratio = g_phys_norm / (g_task_norm + 1e-12)
        else:
            g_phys_norm = g_task_norm = ratio = float('nan')

        damage_std = float(tf.math.reduce_std(damage).numpy())
        damage_mean = float(tf.math.reduce_mean(damage).numpy())

        self._log(f"\n  [A] Raw unweighted losses:")
        self._log(f"      loss_cwru      = {float(loss_cwru):.6f}")
        self._log(f"      loss_paderborn = {float(loss_pader):.6f}")
        self._log(f"      loss_rul       = {float(loss_rul):.6f}")
        self._log(f"      mono_loss      = {float(mono):.6e}")
        self._log(f"      consist_loss   = {float(consist):.6e}")
        self._log(f"      paris_loss     = {float(paris):.6e}")

        self._log(f"\n  [A] Weighted contributions:")
        self._log(f"      w_cwru   * loss_cwru      = {cfg.weight_cwru*float(loss_cwru):.6f}")
        self._log(f"      w_pader  * loss_paderborn = {cfg.weight_paderborn*float(loss_pader):.6f}")
        self._log(f"      w_rul    * loss_rul       = {cfg.weight_pronostia_rul*float(loss_rul):.6f}")
        self._log(f"      alpha    * mono_loss      = {cfg.alpha_mono*float(mono):.6e}")
        self._log(f"      beta     * paris_loss     = {cfg.beta_paris*float(paris):.6e}")
        self._log(f"      gamma    * consist_loss   = {cfg.gamma_consist*float(consist):.6e}")

        total_task = (cfg.weight_cwru*float(loss_cwru) +
                      cfg.weight_paderborn*float(loss_pader) +
                      cfg.weight_pronostia_rul*float(loss_rul))
        total_phys = (cfg.alpha_mono*float(mono) +
                      cfg.beta_paris*float(paris) +
                      cfg.gamma_consist*float(consist))
        pct = 100.0 * total_phys / (total_task + total_phys + 1e-12)
        self._log(f"\n  [A] Physics contribution to total loss: {pct:.4f}%")

        self._log(f"\n  [B] Gradient L2 norms at shared trunk:")
        self._log(f"      ||grad_physics|| = {g_phys_norm:.6e}")
        self._log(f"      ||grad_task||    = {g_task_norm:.6e}")
        self._log(f"      ratio            = {ratio:.6e}")
        if not np.isnan(ratio):
            if ratio < 0.001:
                verdict = "INACTIVE (physics is doing nothing)"
            elif ratio < 0.01:
                verdict = "NEGLIGIBLE"
            elif ratio < 0.1:
                verdict = "WEAK"
            else:
                verdict = "ACTIVE (physics is contributing)"
            self._log(f"      verdict          = {verdict}")

        self._log(f"\n  [C] Damage-head collapse check:")
        self._log(f"      damage mean = {damage_mean:.6f}")
        self._log(f"      damage std  = {damage_std:.6e}")
        if damage_std < 1e-4:
            self._log(f"      verdict     = COLLAPSED")
        else:
            self._log(f"      verdict     = healthy")

        self._log(f"\n  Pronostia samples in batch: "
                  f"{int(tf.reduce_sum(pron_mask))} / {x_in.shape[0]}")

# =============================================
# BUILD MODEL - REDUCED PARAMETERS
# =============================================

def build_multimodal_model(config: MultiModalConfig) -> Model:
    """
    Build model with reduced parameters to prevent overfitting.
    """
    multimodal_in = layers.Input(shape=(config.window_size, 4), name='multimodal_input')
    ews_in = layers.Input(shape=(11,), name='ews_features')  # ← FIXED: 11 features


    
    vib = layers.Lambda(lambda x: x[:, :, 0:1], name='extract_vibration')(multimodal_in)
    current = layers.Lambda(lambda x: x[:, :, 1:3], name='extract_current')(multimodal_in)
    temperature = layers.Lambda(lambda x: x[:, :, 3:4], name='extract_temperature')(multimodal_in)
    
    # ========== VIBRATION BRANCH (REDUCED) ==========
    # Reduce from 4 kernels to 3
    vib_branches = []
    for k in [3, 5, 7]:  # Removed kernel size 9
        x = layers.Conv1D(config.cnn_filters // 2, k, padding='same', activation='relu',  # Reduced filters
                          kernel_regularizer=regularizers.l2(config.l2_reg))(vib)
        x = layers.BatchNormalization()(x)
        x = layers.MaxPooling1D(2)(x)
        vib_branches.append(x)
    vib_merged = layers.concatenate(vib_branches)
    vib_merged = layers.Conv1D(64, 3, padding='same', activation='relu',  # Reduced from 128 to 64
                                kernel_regularizer=regularizers.l2(config.l2_reg))(vib_merged)
    vib_lstm = layers.Bidirectional(layers.LSTM(config.lstm_units // 2, return_sequences=False,  # Reduced LSTM
                                                  dropout=0.2, recurrent_dropout=0.2))(vib_merged)
    
    # ========== CURRENT BRANCH (REDUCED) ==========
    cur_branches = []
    for k in [3, 5]:  # Removed kernel size 7
        x = layers.Conv1D(16, k, padding='same', activation='relu',  # Reduced from 32
                          kernel_regularizer=regularizers.l2(config.l2_reg))(current)
        x = layers.BatchNormalization()(x)
        x = layers.MaxPooling1D(2)(x)
        cur_branches.append(x)
    cur_merged = layers.concatenate(cur_branches)
    cur_merged = layers.Conv1D(32, 3, padding='same', activation='relu',  # Reduced from 64
                                kernel_regularizer=regularizers.l2(config.l2_reg))(cur_merged)
    cur_lstm = layers.Bidirectional(layers.LSTM(32, return_sequences=False,  # Reduced from 64
                                                 dropout=0.2, recurrent_dropout=0.2))(cur_merged)
    
    # ========== TEMPERATURE BRANCH (REDUCED) ==========
    temp_conv = layers.Conv1D(16, 5, padding='same', activation='relu',  # Reduced from 32
                               kernel_regularizer=regularizers.l2(config.l2_reg))(temperature)
    temp_conv = layers.BatchNormalization()(temp_conv)
    temp_conv = layers.Conv1D(16, 3, activation='relu')(temp_conv)  # Reduced from 32
    temp_conv = layers.GlobalAveragePooling1D()(temp_conv)
    temp_dense = layers.Dense(32, activation='relu',  # Reduced from 64
                               kernel_regularizer=regularizers.l2(config.l2_reg))(temp_conv)
    
    
    # ========== EWS BRANCH (REDUCED) ==========
    # Check if EWS should be skipped (for ablation)
    if hasattr(config, 'skip_ews') and config.skip_ews:
        # Skip EWS: use a Lambda layer to create zeros
        print("⚠️ EWS features DISABLED for ablation")
        e = layers.Lambda(lambda x: tf.zeros_like(x), name='ews_zero')(ews_in)
        e = layers.Dense(16, activation='relu', name='ews_dummy')(e)
    else:
        # Original EWS branch
        e = layers.Dense(64, activation='relu',
                         kernel_regularizer=regularizers.l2(config.l2_reg))(ews_in)
        e = layers.BatchNormalization()(e)
        e = layers.Dropout(config.dropout)(e)
        e = layers.Dense(32, activation='relu',
                         kernel_regularizer=regularizers.l2(config.l2_reg))(e)
        e = layers.Dropout(config.dropout)(e)
        e = layers.Dense(16, activation='relu')(e)
        
    # ========== PROJECTION (REDUCED) ==========
    vib_proj = layers.Dense(64, activation='relu',  # Reduced from 128
                             kernel_regularizer=regularizers.l2(config.l2_reg))(vib_lstm)
    cur_proj = layers.Dense(64, activation='relu',  # Reduced from 128
                             kernel_regularizer=regularizers.l2(config.l2_reg))(cur_lstm)
    temp_proj = layers.Dense(64, activation='relu',  # Reduced from 128
                              kernel_regularizer=regularizers.l2(config.l2_reg))(temp_dense)
    ews_proj = layers.Dense(64, activation='relu',  # Reduced from 128
                             kernel_regularizer=regularizers.l2(config.l2_reg))(e)
    
        # ========== CROSS-ATTENTION (REDUCED HEADS) ==========
    # Check if lightweight mode is enabled
    lightweight = hasattr(config, 'lightweight_mode') and config.lightweight_mode
    
    if lightweight:
        # Skip cross-attention, just concatenate projections
        print("⚠️ Lightweight mode: Skipping cross-attention")
        vib_seq = layers.Reshape((1, 64))(vib_proj)
        cur_seq = layers.Reshape((1, 64))(cur_proj)
        temp_seq = layers.Reshape((1, 64))(temp_proj)
        ews_seq = layers.Reshape((1, 64))(ews_proj)
        fused = layers.Concatenate()([vib_seq, cur_seq, temp_seq, ews_seq])
    else:
        # Original cross-attention
        vib_seq = layers.Reshape((1, 64))(vib_proj)
        cur_seq = layers.Reshape((1, 64))(cur_proj)
        temp_seq = layers.Reshape((1, 64))(temp_proj)
        ews_seq = layers.Reshape((1, 64))(ews_proj)
        
        # Reduced from 8 heads to 4
        vib_cur_attn = layers.MultiHeadAttention(num_heads=4, key_dim=16)(query=cur_seq, key=vib_seq, value=vib_seq)
        cur_vib_attn = layers.MultiHeadAttention(num_heads=4, key_dim=16)(query=vib_seq, key=cur_seq, value=cur_seq)
        
        # Simplified temperature attention
        combined_seq = layers.Concatenate()([vib_seq, cur_seq])
        temp_all_attn = layers.MultiHeadAttention(num_heads=4, key_dim=16)(query=temp_seq, key=combined_seq, value=combined_seq)
        
        # ========== FUSION ==========
        fused = layers.Concatenate()([vib_seq, cur_seq, temp_seq, ews_seq, 
                                       vib_cur_attn, cur_vib_attn, temp_all_attn])
    
    combined = layers.Flatten()(fused)
    combined = layers.Dropout(0.3)(combined)
    
    # ========== SHARED LAYERS (REDUCED) ==========
    for units in [64, 32]:  # Reduced from [128, 64]
        combined = layers.Dense(units, activation='relu',
                                 kernel_regularizer=regularizers.l2(config.l2_reg))(combined)
        combined = layers.BatchNormalization()(combined)
        combined = layers.Dropout(config.dropout)(combined)
        
    # ========== DANN DOMAIN CLASSIFIER ==========
    # Check if DANN should be disabled for ablation
    use_dann = hasattr(config, 'use_dann') and config.use_dann
    
    if use_dann:
        # Gradient reversal for domain adaptation
        domain_features = GradientReversalLayer(alpha=1.0, name='gradient_reversal')(combined)
        
        # Domain classifier (predicts CWRU vs Paderborn)
        domain_dense = layers.Dense(32, activation='relu',
                                     kernel_regularizer=regularizers.l2(config.l2_reg))(domain_features)
        domain_dense = layers.BatchNormalization()(domain_dense)
        domain_dense = layers.Dropout(0.3)(domain_dense)
        domain_out = layers.Dense(2, activation='softmax', name='domain')(domain_dense)
    else:
        # Dummy domain output (doesn't affect training)
        domain_out = layers.Lambda(lambda x: tf.zeros_like(x)[:, :2], name='domain_dummy')(combined)
    
    # ========== OUTPUTS ==========
    shared_features = layers.Dense(64, activation='relu')(combined)  # Reduced from 128
    
    cluster_embedding = layers.Dense(16, activation='linear', name='cluster_embedding')(combined)  # Reduced from 32
    shared_damage = layers.Dense(1, activation='sigmoid', name='shared_damage')(combined)
    
    # CWRU
    cwru_logits = layers.Dense(config.cwru_classes, activation='linear', name='cwru_logits')(
        layers.Dropout(0.5)(shared_features))
    if config.temperature_scaling != 1.0:
        cwru_logits = layers.Lambda(lambda x: x / config.temperature_scaling, name='cwru_temp_scaled')(cwru_logits)
    cwru_out = layers.Activation('softmax', name='cwru_class')(cwru_logits)
    
    # Paderborn
    paderborn_logits = layers.Dense(config.paderborn_classes, activation='linear', name='paderborn_logits')(
        layers.Dropout(0.5)(shared_features))
    if config.temperature_scaling != 1.0:
        paderborn_logits = layers.Lambda(lambda x: x / config.temperature_scaling, name='paderborn_temp_scaled')(paderborn_logits)
    paderborn_out = layers.Activation('softmax', name='paderborn_class')(paderborn_logits)
    
    # Pronostia
    pronostia_out = layers.Dense(1, activation='sigmoid', name='pronostia_rul')(
        layers.Dropout(config.dropout)(shared_features))
    
    return Model(inputs=[multimodal_in, ews_in], outputs={
        'cwru_class': cwru_out,
        'paderborn_class': paderborn_out,
        'pronostia_rul': pronostia_out,
        'shared_damage': shared_damage,
        'cluster_embedding': cluster_embedding,
        'domain': domain_out  # ← ADD THIS

    })
    
