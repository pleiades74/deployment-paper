class UncertaintyCalibrator:
    """
    Comprehensive uncertainty calibration with multiple metrics.
    """
    def __init__(self, config):
        self.config = config
    
    def calibrate_and_evaluate(self, model, val_data, test_data, trainer):
        """
        Full uncertainty calibration and evaluation.
        """
        print("\n" + "="*80)
        print("UNCERTAINTY CALIBRATION")
        print("="*80)
        
        # 1. Calibration on validation set
        print("\n📊 1. Calibrating on validation set...")
        calibration_results = self._calibrate_intervals(model, val_data, trainer)
        
        # 2. Evaluate on test set
        print("\n📊 2. Evaluating on test set...")
        test_results = self._evaluate_calibration(model, test_data, trainer, calibration_results)
        
        # 3. Coverage vs interval width
        print("\n📊 3. Coverage-Width Analysis:")
        coverage_width = self._analyze_coverage_width(calibration_results, test_results)
        
        # 4. Reliability diagram
        print("\n📊 4. Creating reliability diagram...")
        self._plot_reliability_diagram(calibration_results, test_results)
        
        # 5. Calibration error metrics
        print("\n📊 5. Calibration Error Metrics:")
        calibration_metrics = self._compute_calibration_metrics(calibration_results, test_results)
        
        # Summary
        print("\n" + "="*80)
        print("UNCERTAINTY CALIBRATION SUMMARY")
        print("="*80)
        print(f"  ECE (Expected Calibration Error): {calibration_metrics['ece']:.4f}")
        print(f"  MCE (Maximum Calibration Error): {calibration_metrics['mce']:.4f}")
        print(f"  Average Interval Width: {calibration_metrics['avg_width']:.4f}")
        print(f"  Mean Coverage: {calibration_metrics['mean_coverage']:.1%}")
        print(f"  {'✅ Well-calibrated' if calibration_metrics['ece'] < 0.05 else '⚠️ Needs improvement'}")
        
        return calibration_results, test_results, calibration_metrics
    
    def _calibrate_intervals(self, model, val_data, trainer):
        """Calibrate prediction intervals using validation data."""
        X_val, X_ews, y_val, _, _, _ = val_data
        
        # Run MC Dropout
        val_mean, val_std, _, _ = trainer.predict_with_uncertainty([X_val, X_ews], n_passes=100)
        val_mean = val_mean.flatten()
        val_std = val_std.flatten()
        y_val = y_val.flatten()
        
        # Compute residuals
        residuals = np.abs(y_val - val_mean)
        
        # Find optimal quantiles
        calibration_results = {}
        for alpha in [0.01, 0.02, 0.05, 0.10, 0.15, 0.20, 0.30, 0.40]:
            q = np.quantile(residuals, 1 - alpha)
            
            # Compute coverage on validation set
            ci_lower = val_mean - q
            ci_upper = val_mean + q
            coverage = np.mean((y_val >= ci_lower) & (y_val <= ci_upper))
            avg_width = np.mean(ci_upper - ci_lower)
            
            calibration_results[1-alpha] = {
                'q': q,
                'coverage': coverage,
                'avg_width': avg_width,
                'calibration_error': abs(coverage - (1-alpha))
            }
        
        return calibration_results
    
    def _evaluate_calibration(self, model, test_data, trainer, calibration_results):
        """Evaluate calibrated intervals on test data."""
        X_test, X_ews, y_test, _, _, _ = test_data
        
        # Run MC Dropout on test
        test_mean, test_std, _, _ = trainer.predict_with_uncertainty([X_test, X_ews], n_passes=100)
        test_mean = test_mean.flatten()
        test_std = test_std.flatten()
        y_test = y_test.flatten()
        
        test_results = {}
        for target_coverage, calib_info in calibration_results.items():
            q = calib_info['q']
            ci_lower = test_mean - q
            ci_upper = test_mean + q
            coverage = np.mean((y_test >= ci_lower) & (y_test <= ci_upper))
            avg_width = np.mean(ci_upper - ci_lower)
            
            test_results[target_coverage] = {
                'coverage': coverage,
                'avg_width': avg_width,
                'calibration_error': abs(coverage - target_coverage)
            }
        
        return test_results
    
    def _analyze_coverage_width(self, calibration_results, test_results):
        """Analyze trade-off between coverage and interval width."""
        coverages = []
        widths = []
        
        for target in sorted(test_results.keys()):
            coverages.append(test_results[target]['coverage'])
            widths.append(test_results[target]['avg_width'])
        
        return {'coverages': coverages, 'widths': widths}
    
    def _plot_reliability_diagram(self, calibration_results, test_results):
        """Plot reliability diagram."""
        fig, axes = plt.subplots(1, 2, figsize=(12, 5))
        
        # 1. Coverage vs Target Coverage
        ax = axes[0]
        target_coverages = sorted(test_results.keys())
        actual_coverages = [test_results[t]['coverage'] for t in target_coverages]
        
        ax.plot(target_coverages, actual_coverages, 'b-', linewidth=2, label='Actual')
        ax.plot([0, 1], [0, 1], 'r--', linewidth=2, label='Ideal')
        ax.set_xlabel('Target Coverage')
        ax.set_ylabel('Actual Coverage')
        ax.set_title('Reliability Diagram')
        ax.legend()
        ax.grid(True, alpha=0.3)
        
        # Add calibration error annotation
        ece = np.mean([abs(a - t) for t, a in zip(target_coverages, actual_coverages)])
        ax.text(0.05, 0.05, f'ECE: {ece:.4f}', transform=ax.transAxes, fontsize=12)
        
        # 2. Interval Width vs Coverage
        ax = axes[1]
        widths = [test_results[t]['avg_width'] for t in target_coverages]
        ax.scatter(actual_coverages, widths, c='blue', alpha=0.6, s=50)
        ax.set_xlabel('Coverage')
        ax.set_ylabel('Average Interval Width')
        ax.set_title('Coverage vs Interval Width')
        ax.grid(True, alpha=0.3)
        
        plt.tight_layout()
        plt.savefig(os.path.join(self.config.output_dir, 'reliability_diagram.pdf'))
        plt.close()
        print(f"  ✅ Saved: reliability_diagram.pdf")
    
    def _compute_calibration_metrics(self, calibration_results, test_results):
        """Compute calibration error metrics."""
        target_coverages = sorted(test_results.keys())
        actual_coverages = [test_results[t]['coverage'] for t in target_coverages]
        widths = [test_results[t]['avg_width'] for t in target_coverages]
        
        # Expected Calibration Error
        ece = np.mean([abs(a - t) for t, a in zip(target_coverages, actual_coverages)])
        
        # Maximum Calibration Error
        mce = max([abs(a - t) for t, a in zip(target_coverages, actual_coverages)])
        
        return {
            'ece': ece,
            'mce': mce,
            'avg_width': np.mean(widths),
            'mean_coverage': np.mean(actual_coverages),
            'target_coverages': target_coverages,
            'actual_coverages': actual_coverages
        }

