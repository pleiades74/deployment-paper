    # =============================================
    # MC DROPOUT UNCERTAINTY
    # =============================================
    
    run_mc_dropout = False
    if run_mc_dropout:
        print("\n🔮 Running Monte Carlo Dropout uncertainty estimation...")
        
        if len(X_pr_test_vib) > 0 and len(pr_val_idx) > 0:
            print("  Computing calibration residuals on validation set...")
            
            X_cal_vib = X_pr_vib[pr_val_idx]
            X_cal_ews = X_pr_ews_val
            y_cal_true = y_pr_rul[pr_val_idx]
            
            X_cal_padded = np.zeros((len(X_cal_vib), config.window_size, 4), dtype=np.float32)
            X_cal_padded[:, :, :2] = X_cal_vib
            
            print("  Running calibration with 100 MC Dropout passes...")
            calib_mean, calib_std, calib_lower, calib_upper = trainer.predict_with_uncertainty(
                [X_cal_padded, X_cal_ews],
                n_passes=100
            )
            
            # =====================================================================
            # FIX: split validation into disjoint fit / eval halves
            #  - fit  half: used to estimate the residual distribution and pick q
            #  - eval half: used to measure the achieved coverage with that q
            # Using the same samples for both inflates the reported coverage.
            # =====================================================================
            n_half = len(X_cal_vib) // 2

            # Fit half: residuals -> quantile candidates
            calib_mean_flat = calib_mean.flatten()
            y_cal_true_flat = y_cal_true
            residuals_fit = np.abs(y_cal_true_flat[:n_half] - calib_mean_flat[:n_half])

            # Eval half: coverage -> honest coverage estimate
            val_eval_mean = calib_mean_flat[n_half:]
            val_eval_true = y_cal_true_flat[n_half:]

            print("  Finding optimal calibration quantile (fit half) "
                  "and measuring coverage (disjoint eval half)...")
            best_q = None
            best_coverage = None

            for alpha in [0.01, 0.02, 0.05, 0.10, 0.15, 0.20]:
                q_candidate = np.quantile(residuals_fit, 1 - alpha)
                ci_lower_test = val_eval_mean - q_candidate
                ci_upper_test = val_eval_mean + q_candidate
                coverage = np.mean((val_eval_true >= ci_lower_test) & (val_eval_true <= ci_upper_test))
                print(f"    alpha={alpha}: q={q_candidate:.4f}, coverage={coverage:.1%}")

                if best_coverage is None or abs(coverage - 0.95) < abs(best_coverage - 0.95):
                    best_coverage = coverage
                    best_q = q_candidate
                    best_alpha = alpha

            
            
            print(f"  ✅ Best alpha={best_alpha}, q={best_q:.4f}, coverage={best_coverage:.1%}")
            
            print("  Applying calibration to test data...")
            n_samples = min(50, len(X_pr_test_vib))
            
            X_pr_test_vib_sample = X_pr_test_vib[:n_samples]
            X_pr_test_ews_sample = X_pr_test_ews_scaled[:n_samples]

            y_true_sample = y_pr_test_rul[:n_samples]
            
            X_pr_test_padded = np.zeros((n_samples, config.window_size, 4), dtype=np.float32)
            X_pr_test_padded[:, :, :2] = X_pr_test_vib_sample
            
            print("  Running test with 100 MC Dropout passes...")
            mean, std, _, _ = trainer.predict_with_uncertainty(
                [X_pr_test_padded, X_pr_test_ews_sample],
                n_passes=100
            )
            
            ci_lower = mean - best_q
            ci_upper = mean + best_q
            
            within_ci = np.mean((y_true_sample >= ci_lower) & (y_true_sample <= ci_upper))
            print(f"  Actual coverage of 95% CI: {within_ci:.1%}")
            print(f"  Calibration error: {abs(0.95 - within_ci):.1%}")
            
            fig, ax = plt.subplots(figsize=(10, 6))
            x_axis = np.arange(len(y_true_sample))
            ax.scatter(x_axis, y_true_sample, label='True RUL', c='red', s=20)
            
            mean_flat = np.array(mean).flatten()
            ci_lower_flat = np.array(ci_lower).flatten()
            ci_upper_flat = np.array(ci_upper).flatten()
            
            ax.plot(x_axis, mean_flat, label='Predicted RUL', c='blue', linewidth=2)
            ax.fill_between(x_axis, ci_lower_flat, ci_upper_flat, alpha=0.3, label='95% CI')
            ax.set_xlabel('Sample Index')
            ax.set_ylabel('RUL')
            ax.set_title('MC Dropout Uncertainty with Calibration')
            ax.legend()
            ax.grid(True, alpha=0.3)
            plt.tight_layout()
            plt.savefig(os.path.join(config.output_dir, 'mc_dropout_calibration.pdf'))
            plt.close()
            print(f"  ✅ Saved: mc_dropout_calibration.pdf")
        else:
