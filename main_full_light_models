                ax.grid(True, alpha=0.3)
                plt.tight_layout()
                plt.savefig(os.path.join(config.output_dir,
                                         'shap_vibration_time.pdf'), dpi=300)
                plt.close()
                print("  ✅ Saved: shap_vibration_time.pdf")

                # ---------------------------------------------------
                # 7. Figure 4 — Per-class EWS attribution
                # ---------------------------------------------------
                # Group explanations by predicted class
                pred_c = model.predict([explain_vib, explain_ews], verbose=0)
                pred_labels = np.argmax(pred_c['cwru_class'], axis=1)

                fig, ax = plt.subplots(figsize=(11, 5))
