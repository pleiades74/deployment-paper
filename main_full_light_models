class PhysicsValidator:
    """
    Comprehensive physics validation with quantitative metrics.
    """
    def __init__(self, config):
        self.config = config
    
    def validate_all(self, model, test_data, config):
        """
        Run all physics validation tests.
        """
        print("\n" + "="*80)
        print("PHYSICS VALIDATION - QUANTITATIVE ANALYSIS")
        print("="*80)
        
        results = {}
        
        # Extract data
        X_test, X_ews, y_rul, _, _, temporal = test_data
        pred = model.predict([X_test, X_ews], verbose=0)
        
        damage = pred['shared_damage'].flatten()
        pred_rul = pred['pronostia_rul'].flatten()
        
        # 1. MONOTONICITY TEST
        print("\n📊 1. Monotonicity Analysis:")
        mono_results = self._test_monotonicity(damage, temporal)
        results['monotonicity'] = mono_results
        print(f"   Violation Rate: {mono_results['violation_rate']:.4f}")
        print(f"   Monotonicity Score: {mono_results['monotonicity_score']:.4f}")
        print(f"   {'✅ Well-satisfied' if mono_results['violation_rate'] < 0.1 else '⚠️ Needs improvement'}")
        
        # 2. DAMAGE-RUL CONSISTENCY
        print("\n📊 2. Damage-RUL Consistency:")
        consist_results = self._test_damage_rul_consistency(damage, pred_rul)
        results['consistency'] = consist_results
        print(f"   Pearson Correlation: {consist_results['correlation']:.4f}")
        print(f"   P-value: {consist_results['p_value']:.6f}")
        print(f"   {'✅ Strong inverse correlation' if consist_results['correlation'] < -0.5 else '⚠️ Weak correlation'}")
        
        # 3. PARIS LAW COMPLIANCE
        print("\n📊 3. Paris Law Compliance:")
        paris_results = self._test_paris_law(damage, temporal)
        results['paris_law'] = paris_results
        print(f"   Paris Law Exponent: {paris_results['exponent']:.4f} (expected ~0.5)")
        print(f"   R²: {paris_results['r2']:.4f}")
        print(f"   {'✅ Good fit' if paris_results['r2'] > 0.7 else '⚠️ Moderate fit'}")
        
        # 4. PHYSICAL BOUNDS
        print("\n📊 4. Physical Bounds:")
        bounds_results = self._test_physical_bounds(damage)
        results['bounds'] = bounds_results
        print(f"   Damage Range: [{bounds_results['min']:.4f}, {bounds_results['max']:.4f}]")
        print(f"   Damage Std: {bounds_results['std']:.4f}")
        print(f"   {'✅ Within reasonable bounds' if 0 < bounds_results['min'] < bounds_results['max'] < 1 else '⚠️ Check bounds'}")
        
        # 5. OVERALL SCORE
        overall_score = self._compute_overall_score(results)
        print("\n📊 5. Overall Physics Score:")
        print(f"   Overall Score: {overall_score:.2f}/1.00")
        print(f"   {'✅ Excellent' if overall_score > 0.8 else '⚠️ Good' if overall_score > 0.6 else '❌ Needs improvement'}")
        
        # Save results
        self._save_physics_results(results, config)
        
        return results
    
    def _test_monotonicity(self, damage, temporal):
        """Test if damage is monotonically increasing."""
        # Sort by temporal position
        sorted_idx = np.argsort(temporal)
        damage_sorted = damage[sorted_idx]
        
        # Count violations (where damage decreases)
        violations = np.sum(damage_sorted[1:] < damage_sorted[:-1])
        total_pairs = len(damage_sorted) - 1
        violation_rate = violations / total_pairs if total_pairs > 0 else 0
        
        # Compute monotonicity score (1 = perfect, 0 = random)
        monotonicity_score = 1 - violation_rate
        
        return {
            'violation_rate': violation_rate,
            'monotonicity_score': monotonicity_score,
            'violations': int(violations),
            'total_pairs': total_pairs
        }
    
    def _test_damage_rul_consistency(self, damage, rul):
        """Test inverse relationship between damage and RUL."""
        from scipy.stats import pearsonr
        corr, p_value = pearsonr(damage, rul)
        
        return {
            'correlation': corr,
            'p_value': p_value,
            'expected': -1.0,  # Perfect inverse
            'deviation': abs(corr - (-1.0))
        }
    
    def _test_paris_law(self, damage, temporal):
        """Test if damage growth follows Paris law."""
        sorted_idx = np.argsort(temporal)
        damage_sorted = damage[sorted_idx]
        
        # Remove zeros and take logs
        valid_idx = damage_sorted > 1e-6
        damage_valid = damage_sorted[valid_idx]
        cycles_valid = np.arange(len(damage_valid)) / len(damage_valid)
        
        if len(damage_valid) < 3:
            return {'exponent': 0, 'r2': 0, 'error': 'Insufficient data'}
        
        log_damage = np.log(damage_valid[1:] + 1e-10)
        log_cycles = np.log(cycles_valid[1:] + 1e-10)
        
        from scipy.stats import linregress
        slope, intercept, r_value, p_value, std_err = linregress(log_cycles, log_damage)
        
        return {
            'exponent': slope,
            'r2': r_value**2,
            'p_value': p_value,
            'std_err': std_err
        }
    
    def _test_physical_bounds(self, damage):
        """Test if damage stays within physical bounds."""
        return {
            'min': np.min(damage),
            'max': np.max(damage),
            'std': np.std(damage),
            'mean': np.mean(damage),
            'in_range': np.all((damage >= 0) & (damage <= 1))
        }
    
    def _compute_overall_score(self, results):
        """Compute overall physics compliance score."""
        scores = []
        
        # Monotonicity score
        if 'monotonicity' in results:
            scores.append(results['monotonicity']['monotonicity_score'])
        
        # Consistency score
        if 'consistency' in results:
            corr = abs(results['consistency']['correlation'])
            score = min(1.0, corr)  # Perfect inverse = 1.0
            scores.append(score)
        
        # Paris law score
        if 'paris_law' in results:
            r2 = results['paris_law']['r2']
            scores.append(r2)
        
        # Bounds score
        if 'bounds' in results:
            in_range = results['bounds']['in_range']
            scores.append(1.0 if in_range else 0.5)
        
        return np.mean(scores) if scores else 0.0
    
    def _save_physics_results(self, results, config):
        """Save physics validation results."""
        import json
        with open(os.path.join(config.output_dir, 'physics_validation.json'), 'w') as f:
            # Convert numpy types to Python types for JSON
            clean_results = {}
            for key, value in results.items():
                if isinstance(value, dict):
                    clean_results[key] = {k: float(v) if isinstance(v, (np.floating, float)) else v 
                                         for k, v in value.items()}
                else:
                    clean_results[key] = float(value) if isinstance(value, (np.floating, float)) else value
            json.dump(clean_results, f, indent=2)
        
        print(f"\n  ✅ Physics results saved to: {config.output_dir}/physics_validation.json")

