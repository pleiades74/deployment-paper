# ---- IG computation ----
def integrated_gradients(model, vib, ews, baseline_vib, baseline_ews, score_fn, steps=8):
    alphas = np.linspace(0, 1, steps + 1)[1:]
    ig_vib = np.zeros_like(vib, dtype=np.float32)
    ig_ews = np.zeros_like(ews, dtype=np.float32)
    for a in alphas:
        iv = baseline_vib + a * (vib - baseline_vib)
        ie = baseline_ews + a * (ews - baseline_ews)
        with tf.GradientTape() as tape:
            v = tf.convert_to_tensor(iv, tf.float32)
            e = tf.convert_to_tensor(ie, tf.float32)
            tape.watch([v, e])
            score = score_fn(v, e)
        gv, ge = tape.gradient(score, [v, e])
        ig_vib += gv.numpy()
        ig_ews += ge.numpy()
    ig_vib /= steps
    ig_ews /= steps
    ig_vib *= (vib - baseline_vib)
    ig_ews *= (ews - baseline_ews)
    return ig_vib, ig_ews

N_BG, N_EXPLAIN, STEPS = 80, 15, 8
baseline_vib = np.mean(X_p_test[:N_BG], axis=0, keepdims=True)
baseline_ews = np.mean(X_p_ews_scaled[:N_BG], axis=0, keepdims=True)
explain_vib = X_p_test[N_BG:N_BG+N_EXPLAIN].astype(np.float32)
explain_ews = X_p_ews_scaled[N_BG:N_BG+N_EXPLAIN].astype(np.float32)

@tf.function(reduce_retracing=True)
def pader_score(v, e):
    p = model([v, e], training=False)
    return tf.reduce_max(p['paderborn_class'], axis=-1)

all_v, all_e = [], []
for i in range(N_EXPLAIN):
    gv, ge = integrated_gradients(model, explain_vib[i:i+1], explain_ews[i:i+1],
                                   baseline_vib, baseline_ews, pader_score, STEPS)
    all_v.append(gv); all_e.append(ge)

ig_vib = np.vstack(all_v)
ig_ews = np.vstack(all_e)

