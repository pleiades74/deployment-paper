# ============================================================
# Integrated Gradients
# ============================================================
# We compute attribution for the *predicted class probability*
# for each explained sample. Baseline = mean of background set.
# ============================================================

# Baseline: mean over the background set (single reference point)
baseline_vib = np.mean(bg_vib, axis=0, keepdims=True).astype(np.float32)  # (1, 1024, 4)
baseline_ews = np.mean(bg_ews, axis=0, keepdims=True).astype(np.float32)  # (1, 11)


def integrated_gradients(model, vib, ews, baseline_vib, baseline_ews,
                         n_steps=32, target_class=None):
    """
    Compute Integrated Gradients for a multi-modal model.

    Args:
        model:        trained Keras model returning dict with 'cwru_class'
        vib:          (N, 1024, 4) float32
        ews:          (N, 11)      float32
        baseline_vib: (1, 1024, 4) float32
        baseline_ews: (1, 11)      float32
        n_steps:      number of Riemann steps along the path
        target_class: int or None. If None, use argmax per sample.

    Returns:
        ig_vib: (N, 1024, 4) attributions
        ig_ews: (N, 11)      attributions
    """
    vib = tf.convert_to_tensor(vib, dtype=tf.float32)
    ews = tf.convert_to_tensor(ews, dtype=tf.float32)
    bv = tf.convert_to_tensor(baseline_vib, dtype=tf.float32)
    be = tf.convert_to_tensor(baseline_ews, dtype=tf.float32)

    N = tf.shape(vib)[0]

    # Broadcast baseline to match batch
    bv = tf.tile(bv, [N, 1, 1])
    be = tf.tile(be, [N, 1])

    # Determine target class per sample
    if target_class is None:
        preds = model([vib, ews], training=False)['cwru_class']
        targets = tf.argmax(preds, axis=-1)  # (N,)
    else:
        targets = tf.fill([N], target_class)

    # Build alphas: (n_steps,)
    alphas = tf.linspace(0.0, 1.0, n_steps + 1)[1:]  # skip alpha=0
    alphas = tf.cast(alphas, tf.float32)

    # Accumulate gradients
    total_grad_vib = tf.zeros_like(vib)
    total_grad_ews = tf.zeros_like(ews)

    for alpha in tf.unstack(alphas):
        # Interpolated inputs along straight-line path
        interp_vib = bv + alpha * (vib - bv)
        interp_ews = be + alpha * (ews - be)

        with tf.GradientTape() as tape:
            tape.watch([interp_vib, interp_ews])
            preds = model([interp_vib, interp_ews], training=False)['cwru_class']
            # Gather target-class probability per sample
            idx = tf.stack([tf.range(N), targets], axis=1)
            target_probs = tf.gather_nd(preds, idx)  # (N,)
            loss = tf.reduce_sum(target_probs)

        grads = tape.gradient(loss, [interp_vib, interp_ews])
        total_grad_vib += grads[0]
        total_grad_ews += grads[1]

    avg_grad_vib = total_grad_vib / tf.cast(n_steps, tf.float32)
    avg_grad_ews = total_grad_ews / tf.cast(n_steps, tf.float32)

    # IG = (input - baseline) * avg_grad
    ig_vib = (vib - bv) * avg_grad_vib
    ig_ews = (ews - be) * avg_grad_ews

    return ig_vib.numpy(), ig_ews.numpy()


